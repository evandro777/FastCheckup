msgstr "Só desativar"

msgctxt "Main"
msgid "ZFS pools exist on this computer. Disabling the ZFS services may stop them from mounting at boot."
msgstr "Existem pools ZFS neste computador. Desativar os serviços ZFS pode impedir que sejam montados no boot."

msgctxt "Main"
msgid "No ZFS pools found (zpool list), so these services have nothing to manage."
msgstr "Nenhum pool ZFS encontrado (zpool list), então estes serviços não têm o que gerenciar."

msgctxt "Main"
msgid "A touchpad or touchscreen was found. Touchegg is what gives it multi-finger gestures."
msgstr "Um touchpad ou tela sensível ao toque foi encontrado. O Touchegg é o que fornece os gestos com vários dedos."

msgctxt "Main"
msgid "No touchpad or touchscreen was found, so Touchegg has nothing to do."
msgstr "Nenhum touchpad ou tela sensível ao toque foi encontrado, então o Touchegg não tem o que fazer."

msgctxt "Main"
msgid "A modem or USB serial device was found. ModemManager manages it."
msgstr "Um modem ou dispositivo serial USB foi encontrado. O ModemManager o gerencia."

msgctxt "Main"
msgid "No modem was found, so ModemManager has nothing to manage."
msgstr "Nenhum modem foi encontrado, então o ModemManager não tem o que gerenciar."

msgctxt "Main"
msgid "Other services depend on it: {}. It will only be disabled for the next boot; it keeps running now."
msgstr "Outros serviços dependem dele: {}. Ele só será desativado para o próximo boot; continua rodando agora."

