msgid "{} failed to read or write data {} times. System message: {}"
msgstr "{} falhou ao ler ou gravar dados {} vezes. Mensagem do sistema: {}"

msgctxt "Main"
msgid "A disk"
msgstr "Um disco"

msgctxt "Main"
msgid "Checking health asks for your administrator password and needs the smartmontools package."
msgstr "Verificar a saúde pede sua senha de administrador e precisa do pacote smartmontools."

