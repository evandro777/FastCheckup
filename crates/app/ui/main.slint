import { Button, CheckBox, ComboBox, LineEdit, ScrollView, SpinBox, Switch, Palette } from "std-widgets.slint";
import { Family } from "family.slint";
import { AboutCard, PrefRow } from "about.slint";
import { CloseButton, FilterBar, Icon, MenuButton, NeutralBadge, SearchBox } from "controls.slint";

// One startup entry. `state`: 0 enabled, 1 disabled (by anyone).
export struct Row {
    file: string,
    name: string,
    comment: string,
    exec: string,
    icon: image,
    delay: int,
    source: string,
    target: string,
    essential: bool,
    state: int,
    duplicate-of: string,
}

// `kind`: 0 disabled, 1 restored, 2 changed, 3 removed, 4 delay changed.
export struct HistoryRow {
    time: string,
    kind: int,
    name: string,
}

// One systemd service. `enabled`: starts at boot; `active`: running now; `secs`: start time, 0 when unknown.
export struct Svc {
    unit: string,
    description: string,
    enabled: bool,
    active: bool,
    secs: float,
    essential: bool,
    background: bool,
}

// One installed app. `source`: 0 Debian package, 1 Flatpak, 2 AppImage. `last` is a date, "" when unknown (no data
// folder was found, which is not the same as unused). `group` indexes Tr.group, -1 when no other app does the same job.
export struct AppRow {
    id: string,
    name: string,
    source: int,
    size-mb: float,
    manual: bool,
    essential: bool,
    last: string,
    stale: bool,
    group: int,
    group-count: int,
    icon: image,
}

// An installed kernel. `version` has no flavour, e.g. 7.0.0-28. `keep`: never offered for removal.
export struct Kern {
    running: bool,
    keep: bool,
    version: string,
    size-mb: float,
}

// Data left in ~/.var/app by a Flatpak that is no longer installed.
// A mounted filesystem on the Storage page, sizes in GB.
export struct Mnt {
    path: string,
    used-gb: float,
    total-gb: float,
    pct: int,
}

// One line of the bulk clean-up dialog. `action` is the code listed at `app-action`; `cmd` is the command line shown for
// it ("" for the root steps, which share one line); `on` is the tick.
export struct BulkRow {
    action: int,
    id: string,
    // What the row shows: `id` cut to its last folders when it is a long path.
    name: string,
    size-mb: float,
    on: bool,
    cmd: string,
    // Packages or runtimes the row removes, joined with ", "; "" for the others.
    detail: string,
}

export struct Left {
    id: string,
    // Folder or file the Open button shows (see `open-path`); "" when the row has none.
    path: string,
    size-mb: float,
    last: string,
    // Old tool versions only: 0 can go, 1 newest, 2 a game uses it, 3 Steam manages it, 4 Steam's default tool.
    keep: int,
    // Names of the games set to use this tool, joined with ", "; "" when none.
    used: string,
}

// One row of `docker system df`; the texts are Docker's own.
export struct Dock {
    kind: string,
    size: string,
    reclaim: string,
}

// `kind`: 0 firmware, 1 loader, 2 kernel, 3 initrd, 4 userspace.
export struct Phase {
    kind: int,
    secs: float,
}

// One application in the Overview's "Right now" list; `cpu` is a share of the whole computer.
export struct PerfApp {
    name: string,
    procs: int,
    cpu: float,
    mem-mb: float,
}

// A disk on the Disk health page. `state`: 0 not checked, 1 passed, 2 failed, 3 could not read, 4 checking.
export struct Disk {
    name: string,
    model: string,
    size: string,
    // 0 SSD, 1 hard drive, 2 NVMe, 3 USB.
    kind: int,
    // One text per block, so a block selects and copies in one go: `info` the partitions, `problems` failed mounts and kernel errors.
    info: string,
    // Lines in `info`, for the "Show partitions" link.
    parts: int,
    problems: string,
    state: int,
    reallocated: int,
    pending: int,
    uncorrectable: int,
    crc: int,
    // NVMe disks report wear instead of ATA counters; `nvme` picks the text.
    nvme: bool,
    used: int,
    spare: int,
    error: string,
}

// A line on the Security page. `code` picks the sentence (see `Tr.finding-line`); `level`: 0 information, 1 worth a look, 2 suspicious.
export struct Finding {
    code: int,
    level: int,
    subject: string,
    extra: string,
    n: int,
    // Topic, set in Rust (`finding_group`); the page shows a heading where it changes.
    group: int,
    // Application the finding belongs to, "" when none: rows sharing it sit under one header with its icon and the
    // executable path (set in Rust).
    app: string,
    icon: image,
    path: string,
}

// System page: a card with a title and label/value rows. A row with an empty label shows only the value.
export struct SysRow {
    label: string,
    value: string,
}

export struct SysGroup {
    title: string,
    rows: [SysRow],
}

// A recommended scanner: what to run is shown as text, never executed by the app.
export struct SecTool {
    name: string,
    cmd: string,
    installed: bool,
}

// A unit on the critical chain. `frac` is took / the longest took, for the bar.
export struct Link {
    unit: string,
    at: float,
    took: float,
    frac: float,
    optional: bool,
    slowest: bool,
    mount: bool,
}

// `loader`: 0 GRUB, 1 systemd-boot, 2 unknown. `timeout` is -1 when unset.
export struct Grub {
    loader: int,
    efi: bool,
    timeout: int,
    style: string,
    overridden: string,
    windows: bool,
    has-backup: bool,
}

// Strings Rust needs but must not build itself. `kind`: 0 ZFS, 1 Touchegg, 2 ModemManager.
export global Tr {
    public pure function scanned-ago(min: int) -> string {
        if (min < 1) { return @tr("Main" => "Scanned just now"); }
        if (min < 60) { return @tr("Main" => "Scanned {} min ago", min); }
        return @tr("Main" => "Scanned {} h ago", Math.floor(min / 60));
    }
    public pure function finding-group(group: int) -> string {
        if (group == 0) { return @tr("Main" => "Network"); }
        if (group == 1) { return @tr("Main" => "Programs running"); }
        if (group == 2) { return @tr("Main" => "Starts by itself"); }
        if (group == 3) { return @tr("Main" => "Accounts and logins"); }
        if (group == 4) { return @tr("Main" => "Browser add-ons"); }
        return @tr("Main" => "Updates");
    }
    public pure function finding-line(code: int, subject: string, extra: string, n: int) -> string {
        if (code == 0) { return extra != "" ? @tr("Main" => "{} is open to the network on: {}", extra, subject) : @tr("Main" => "Open to the network on: {} (program unknown: it belongs to another user)", subject); }
        if (code == 1) {
            let who = subject != "" ? subject : @tr("Main" => "A program");
            return n == 1 ? @tr("Main" => "{} has 1 connection to another computer, e.g. {}", who, extra) : @tr("Main" => "{} has {} connections to other computers, e.g. {}", who, n, extra);
        }
        if (code == 2) { return @tr("Main" => "{} runs from {} ({} processes). Programs normally run from system folders.", extra, subject, n); }
        if (code == 3) { return @tr("Main" => "{} is loaded into every program through ld.so.preload. Rootkits use this.", subject); }
        if (code == 4) { return @tr("Main" => "Scheduled job (cron): {}", subject); }
        if (code == 5) { return @tr("Main" => "Your user runs a systemd unit of its own: {}", subject); }
        if (code == 6) { return @tr("Main" => "{} lists {} keys that can log in to this account over SSH. Check you know each one.", subject, n); }
        if (code == 7) { return @tr("Main" => "{} changed in the last 30 days and has {} lines that download or decode things, e.g. {}", subject, n, extra); }
        // Only the tail: the page draws the add-on name (`subject`) in bold in front of it.
        if (code == 8) { return @tr("Main" => "can read or change a lot: {}", extra); }
        if (code == 9) { return @tr("Main" => "{} failed login attempts in the last 24 hours.", n); }
        if (code == 11) { return subject != "" ? @tr("Main" => "Restart needed to finish updating: {}", subject) : @tr("Main" => "Restart needed to finish updating."); }
        if (code == 12) { return @tr("Main" => "The running kernel {} is no longer installed. Restart to use the new one.", subject); }
        if (code == 13) { return extra != "" ? @tr("Main" => "{} updates waiting, {} of them security updates (as of the last package list refresh)", n, extra) : @tr("Main" => "{} updates waiting (as of the last package list refresh)", n); }
        if (code == 14) { return @tr("Main" => "Packages held back from updates: {}", subject); }
        return @tr("Main" => "The firewall (ufw) is {}. Rules were not read; that needs administrator rights.", subject);
    }
    // Under an application header the name is already shown, so the two network lines drop it.
    public pure function row-line(code: int, subject: string, extra: string, n: int, in-app: bool) -> string {
        if (in-app && code == 0) { return @tr("Main" => "Open to the network on: {}", subject); }
        if (in-app && code == 1) { return n == 1 ? @tr("Main" => "1 connection to another computer, e.g. {}", extra) : @tr("Main" => "{} connections to other computers, e.g. {}", n, extra); }
        return finding-line(code, subject, extra, n);
    }
    public pure function history-line(time: string, kind: int, name: string) -> string {
        return @tr("Main" => "{} UTC", time) + "  " + (kind == 0 ? @tr("Main" => "Disabled") : kind == 1 ? @tr("Main" => "Restored") : kind == 2 ? @tr("Main" => "Changed") : kind == 3 ? @tr("Main" => "Removed") : @tr("Main" => "Delay changed")) + "  " + name;
    }
    public pure function part-line(state: int, label: string, size: string, mount: string) -> string {
        if (state == 1) { return @tr("Main" => "{} ({}) failed to mount at {}. Do not make it mount automatically; check the disk first.", label, size, mount); }
        if (state == 2) { return @tr("Main" => "{} ({}) is not mounted. It is set up for {}.", label, size, mount); }
        return @tr("Main" => "{} ({}) is mounted at {}.", label, size, mount);
    }
    public pure function error-line(device: string, count: int, line: string) -> string {
        return @tr("Main" => "{} failed to read or write data {} times. System message: {}", device != "" ? device : @tr("Main" => "A disk"), count, line);
    }
    public pure function failed-mount-line(mount: string) -> string {
        return @tr("Main" => "{} failed to mount. Check that its disk or network share is connected.", mount);
    }
    public pure function memory-line(code: int, a: string) -> string {
        if (code == 0) { return @tr("Main" => "Swap is set up ({}).", a); }
        if (code == 1) { return @tr("Main" => "No swap is set up."); }
        if (code == 2) { return @tr("Main" => "{} is running and will stop a program that uses all the memory.", a); }
        if (code == 3) { return @tr("Main" => "Nothing is watching for low memory (systemd-oomd or earlyoom)."); }
        if (code == 4) { return @tr("Main" => "The kernel killed {} programs for lack of memory since the previous boot.", a); }
        return @tr("Main" => "Without swap or a watcher, the computer can freeze for minutes when memory runs out. To add a watcher, run: {}", a);
    }
    // System page words; Rust passes the data and builds the rows and the "Copy all" text from these.
    public pure function sys-group(code: int) -> string {
        if (code == 0) { return @tr("Main" => "System"); }
        if (code == 1) { return @tr("Main" => "BIOS"); }
        if (code == 2) { return @tr("Main" => "Motherboard"); }
        if (code == 3) { return @tr("Main" => "Graphics"); }
        if (code == 4) { return @tr("Main" => "Hardware acceleration"); }
        if (code == 5) { return @tr("Main" => "Disks"); }
        if (code == 6) { return @tr("Main" => "USB devices"); }
        if (code == 7) { return @tr("Main" => "Monitors"); }
        if (code == 8) { return @tr("Main" => "Audio"); }
        if (code == 10) { return @tr("Main" => "Kernel limits"); }
        return @tr("Main" => "Network");
    }
    public pure function sys-label(code: int) -> string {
        if (code == 0) { return @tr("Main" => "Computer"); }
        if (code == 1) { return @tr("Main" => "Operating system"); }
        if (code == 2) { return @tr("Main" => "Linux kernel"); }
        if (code == 3) { return @tr("Main" => "Processor"); }
        if (code == 4) { return @tr("Main" => "Memory"); }
        if (code == 5) { return @tr("Main" => "Desktop environment"); }
        if (code == 6) { return @tr("Main" => "Display server"); }
        if (code == 7) { return @tr("Main" => "Brand"); }
        if (code == 8) { return @tr("Main" => "Version"); }
        if (code == 9) { return @tr("Main" => "Release"); }
        if (code == 10) { return @tr("Main" => "Release date"); }
        if (code == 11) { return @tr("Main" => "Boot mode"); }
        if (code == 12) { return @tr("Main" => "Secure Boot"); }
        if (code == 13) { return @tr("Main" => "Name"); }
        if (code == 14) { return @tr("Main" => "PCI ID"); }
        if (code == 15) { return @tr("Main" => "Driver"); }
        if (code == 16) { return @tr("Main" => "Driver version"); }
        if (code == 17) { return @tr("Main" => "OpenGL"); }
        if (code == 18) { return @tr("Main" => "OpenGL ES"); }
        if (code == 19) { return @tr("Main" => "Vulkan"); }
        if (code == 20) { return @tr("Main" => "Video decoding (VA-API)"); }
        if (code == 21) { return @tr("Main" => "Video decoding (VDPAU)"); }
        if (code == 22) { return @tr("Main" => "Hostname"); }
        if (code == 23) { return @tr("Main" => "Uptime"); }
        if (code == 24) { return @tr("Main" => "Swap"); }
        if (code == 26) { return @tr("Main" => "File watches"); }
        if (code == 27) { return @tr("Main" => "Memory maps"); }
        return @tr("Main" => "Video memory");
    }
    public pure function sys-text(code: int, a: string, b: string, c: string) -> string {
        if (code == 0) { return @tr("Main" => "{} cores, {} threads", a, b); }
        if (code == 1) { return @tr("Main" => "{} cores, {} threads, up to {} GHz", a, b, c); }
        if (code == 2) { return @tr("Main" => "{} GB", a); }
        if (code == 3) { return @tr("Main" => "UEFI"); }
        if (code == 4) { return @tr("Main" => "Legacy BIOS"); }
        if (code == 5) { return @tr("Main" => "Enabled"); }
        if (code == 6) { return @tr("Main" => "Disabled"); }
        if (code == 7) { return @tr("Main" => "Unknown"); }
        if (code == 8) { return @tr("Main" => "Enabled ({})", a); }
        if (code == 9) { return @tr("Main" => "Not available"); }
        if (code == 10) { return @tr("Main" => "Not available ({})", a); }
        if (code == 11) { return @tr("Main" => "Not checked: install the {} package", a); }
        if (code == 12) { return @tr("Main" => "Included in the kernel"); }
        if (code == 13) { return @tr("Main" => "{}: {} at {} Hz", a, b, c); }
        if (code == 14) { return @tr("Main" => "{} ({}, {})", a, b, c); }
        if (code == 15) { return @tr("Main" => "{} ({})", a, b); }
        if (code == 17) { return @tr("Main" => "{} min", a); }
        if (code == 18) { return @tr("Main" => "{} h {} min", a, b); }
        if (code == 19) { return @tr("Main" => "{} d {} h {} min", a, b, c); }
        if (code == 20) { return @tr("Main" => "Not configured"); }
        if (code == 21) { return @tr("Main" => "{}: too low for {}, which may stop watching your folders. To raise it, run: {}", a, b, c); }
        if (code == 22) { return @tr("Main" => "{}: too low for some games, which may crash on start. To raise it, run: {}", a, b); }
        return @tr("Main" => "None found");
    }
    public pure function level-text(level: int) -> string {
        return level == 3 ? @tr("Main" => "Needs attention") : level == 2 ? @tr("Main" => "Worth a look") : level == 1 ? @tr("Main" => "No problems seen") : @tr("Main" => "Not checked yet");
    }
    public pure function phase(kind: int) -> string {
        if (kind == 0) { return @tr("Main" => "Firmware"); }
        if (kind == 1) { return @tr("Main" => "Boot loader"); }
        if (kind == 2) { return @tr("Main" => "Kernel"); }
        if (kind == 3) { return @tr("Main" => "Initrd"); }
        return @tr("Main" => "Userspace");
    }
    public pure function phase-color(kind: int) -> color {
        return kind == 0 ? Theme.muted : kind == 1 ? Family.warning : kind == 2 ? Family.info : kind == 3 ? Theme.purple : Family.success;
    }
    public pure function hint(kind: int, in-use: bool) -> string {
        if (kind == 0) {
            return in-use ? @tr("Main" => "ZFS pools exist on this computer. Disabling the ZFS services may stop them from mounting at boot.")
                : @tr("Main" => "No ZFS pools found (zpool list), so these services have nothing to manage.");
        }
        if (kind == 1) {
            return in-use ? @tr("Main" => "A touchpad or touchscreen was found. Touchegg is what gives it multi-finger gestures.")
                : @tr("Main" => "No touchpad or touchscreen was found, so Touchegg has nothing to do.");
        }
        return in-use ? @tr("Main" => "A modem or USB serial device was found. ModemManager manages it.")
            : @tr("Main" => "No modem was found, so ModemManager has nothing to manage.");
    }
    public pure function loader(kind: int) -> string {
        return kind == 0 ? "GRUB" : kind == 1 ? "systemd-boot" : @tr("Main" => "unknown");
    }
    public pure function group(kind: int) -> string {
        if (kind == 0) { return @tr("Main" => "web browsers"); }
        if (kind == 1) { return @tr("Main" => "text editors"); }
        if (kind == 2) { return @tr("Main" => "video players"); }
        if (kind == 3) { return @tr("Main" => "audio players"); }
        if (kind == 4) { return @tr("Main" => "system monitors"); }
        if (kind == 5) { return @tr("Main" => "archive managers"); }
        if (kind == 6) { return @tr("Main" => "email clients"); }
        if (kind == 7) { return @tr("Main" => "file managers"); }
        if (kind == 8) { return @tr("Main" => "terminals"); }
        return @tr("Main" => "chat apps");
    }
    public pure function also-removed(list: string) -> string {
        return @tr("Main" => "It will also remove: {}", list);
    }
    public pure function runtimes(list: string) -> string {
        return @tr("Main" => "Nothing installed needs these: {}", list);
    }
    public pure function dependents(list: string) -> string {
        return @tr("Main" => "Other services depend on it: {}. It will only be disabled for the next boot; it keeps running now.", list);
    }
}

// What is specific to this app. The status colors, type scale and spacing are in `Family` (family.slint).
export global Theme {
    // Grey of an area that has not been scanned yet.
    out property <color> muted: Family.muted;
    // Categories, not status: the boot chart and the Debian chip.
    out property <color> purple: #8b5cf6;
    // Area status: 0 not scanned, 1 fine, 2 worth a look, 3 problem.
    public pure function level-color(level: int) -> color {
        return level == 3 ? Family.danger : level == 2 ? Family.warning : level == 1 ? Family.success : root.muted;
    }
    // How safe a clean-up is: 0 safe, 1 almost safe, 2 must analyze. A whole shield, a half one and a question mark, so
    // the level reads without colour; the tab label and the card title carry the words. Anything else: no icon.
    public pure function tier-icon(tier: int) -> image {
        return tier == 0 ? @image-url("icons/shield-check.svg")
            : tier == 1 ? @image-url("icons/shield-half.svg")
            : tier == 2 ? @image-url("icons/shield-question.svg")
            : @image-url("");
    }
    // One size format for every row, so a 4 GB app never reads "4096 MB".
    public pure function size(mb: float) -> string {
        return mb >= 1000 ? @tr("Main" => "{} GB", Math.round(mb / 100) / 10) : @tr("Main" => "{} MB", Math.round(mb));
    }
    public pure function tier-tone(tier: int) -> color {
        return tier == 0 ? Family.success : tier == 1 ? Family.info : Family.warning;
    }
}

// All @tr strings use the explicit context "Main" so the .po files stay simple.
component Chip inherits Rectangle {
    in property <string> text;
    in property <color> tone;
    background: root.tone.with-alpha(0.18);
    border-radius: Family.control-radius;
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text { text: root.text; color: root.tone; font-size: Family.caption; font-weight: Family.section-weight; horizontal-alignment: center; }
    }
}

// `level` is the area status (see `Theme.level-color`); 0 shows no dot.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <int> level;
    // A page of the group above: indented, no icon and no status dot.
    in property <bool> sub;
    // The group's own page is closed and one of its sub-pages is open: only the sub-page gets the fill and the bar.
    in property <bool> quiet;
    callback clicked();
    height: root.sub ? 28px : 34px;
    border-radius: Family.control-radius;
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.level > 0 ? Tr.level-text(root.level) : "";
    background: root.active && !root.quiet ? Palette.foreground.with-alpha(0.1) : ta.has-hover ? Palette.foreground.with-alpha(0.08) : transparent;
    if root.active && !root.sub && !root.quiet : Rectangle { x: 0px; y: parent.height * 0.2; width: 3px; height: parent.height * 0.6; border-radius: 1.5px; background: Palette.accent-background; }
    if !root.sub : Icon { x: 12px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: root.icon; tone: root.active ? Palette.foreground : Palette.foreground.with-alpha(0.62); }
    Text {
        // A sub-item has no icon or status dot, so it starts earlier and may use that room (long translations).
        x: root.sub ? 26px : 36px;
        width: parent.width - (root.sub ? 30px : 54px);
        text: root.text;
        font-size: Family.body;
        color: Palette.foreground;
        font-weight: root.active ? Family.section-weight : 400;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.level > 0 : Rectangle { x: parent.width - 17px; y: (parent.height - 7px) / 2; width: 7px; height: 7px; border-radius: 3.5px; background: Theme.level-color(root.level); }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// For actions that remove something: outlined in red, so it never looks like the safe choice.
component DangerButton inherits Rectangle {
    in property <string> text;
    // Neutral colours for clean-ups the Safe and Almost safe tabs already vouch for; red stays for the rest.
    in property <bool> calm;
    callback clicked();
    width: label.preferred-width + 46px;
    height: 32px;
    border-width: 1px;
    border-color: root.calm ? Palette.border : Family.danger;
    border-radius: Family.control-radius;
    background: ta.has-hover ? (root.calm ? Palette.foreground.with-alpha(0.1) : Family.danger.with-alpha(0.15)) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Icon { x: 12px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; source: @image-url("icons/trash.svg"); tone: root.calm ? Palette.foreground : Family.danger; }
    label := Text { x: 34px; width: parent.width - 46px; text: root.text; color: root.calm ? Palette.foreground : Family.danger; font-weight: root.calm ? 400 : Family.section-weight; horizontal-alignment: left; vertical-alignment: center; }
    // Focus ring in the accent colour, outside the red border, so a keyboard user can see where they are.
    if fs.has-focus : Rectangle { x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; border-width: 2px; border-color: Palette.accent-background; border-radius: 6px; }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { fs.focus(); root.clicked(); } }
    }
}

// A quiet icon-only button for a secondary row action (the label is for screen readers and the keyboard).
component IconButton inherits Rectangle {
    in property <image> source;
    in property <string> label;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: Family.control-radius;
    background: ta.has-hover ? Palette.foreground.with-alpha(0.1) : fs.has-focus ? Palette.foreground.with-alpha(0.06) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { x: 8px; y: 8px; width: 16px; height: 16px; source: root.source; tone: Palette.foreground.with-alpha(0.8); }
    if fs.has-focus : Rectangle { x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; border-width: 2px; border-color: Palette.accent-background; border-radius: Family.control-radius + 2px; }
    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") { root.clicked(); return accept; }
            return reject;
        }
        ta := TouchArea { mouse-cursor: pointer; clicked => { fs.focus(); root.clicked(); } }
    }
}

// An app icon, or a plain rounded tile when none was found, so names line up either way.
component AppIcon inherits Rectangle {
    in property <image> source;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: root.source.width > 0 ? transparent : Palette.foreground.with-alpha(0.08);
    Image { source: root.source; width: parent.width; height: parent.height; image-fit: contain; }
    // No icon found: a generic package, so the tile does not read as a missing image.
    if root.source.width == 0: Image {
        x: 8px;
        y: 8px;
        width: 16px;
        height: 16px;
        source: @image-url("icons/package.svg");
        colorize: Palette.foreground.with-alpha(0.4);
    }
}

component RowItem inherits VerticalLayout {
    in property <Row> item;
    in property <bool> open;
    // The active filters (0 = All). A chip that repeats the filter is left out; every shown row has it.
    in property <int> status-filter;
    in property <int> rec-filter;
    callback toggle();
    callback act();
    callback edit();
    callback set-delay(int);
    spacing: 0px;

    pure function explain() -> string {
        if (root.item.state == 0) {
            return @tr("Main" => "Starts automatically when you log in. Disabling it only stops it from starting; the app stays installed.");
        }
        return @tr("Main" => "Disabled. Enable makes it start automatically when you log in again.");
    }

    Rectangle {
        height: 54px;
        background: head-ta.has-hover || root.open ? Palette.foreground.with-alpha(0.06) : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            // Always 32px wide so names line up whether or not the icon was found.
            AppIcon { source: root.item.icon; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.item.name; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                Text {
                    text: root.item.duplicate-of != "" ? @tr("Main" => "Starts the same program as \"{}\"", root.item.duplicate-of)
                        : root.item.comment != "" ? root.item.comment : root.item.exec;
                    color: root.item.duplicate-of != "" ? Family.warning : Family.muted;
                    font-size: Family.body;
                    overflow: elide;
                }
            }
            Text {
                text: root.item.delay > 0 ? @tr("Main" => "{} s", root.item.delay) : "";
                width: 48px;
                color: Family.muted;
                font-size: Family.body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            // Fixed-width column so the badges line up on the right in every row.
            if root.rec-filter == 0 : VerticalLayout {
                alignment: center;
                width: 96px;
                Chip { text: root.item.essential ? @tr("Main" => "Essential") : @tr("Main" => "Optional"); tone: root.item.essential ? Family.warning : Family.info; }
            }
            if root.status-filter == 0 : VerticalLayout {
                alignment: center;
                width: 96px;
                Chip { text: root.item.state == 0 ? @tr("Main" => "Enabled") : @tr("Main" => "Disabled"); tone: root.item.state == 0 ? Family.success : Theme.muted; }
            }
            VerticalLayout { alignment: center; Icon { source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; } }
        }
        head-ta := TouchArea { clicked => { root.toggle(); } }
    }

    if root.open : VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        if root.item.essential : Text {
            text: @tr("Main" => "Part of the desktop. Disabling it may break your session.");
            wrap: word-wrap;
            color: Family.danger;
        }
        Text { text: root.explain(); wrap: word-wrap; color: Palette.foreground; }
        TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Command: {}", root.item.exec); wrap: word-wrap; font-size: Family.body; color: Family.muted; }
        HorizontalLayout {
            spacing: 8px;
            TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "File: {}", root.item.source); wrap: word-wrap; font-size: Family.body; color: Family.muted; horizontal-stretch: 1; }
            Button { text: @tr("Main" => "Open in editor"); clicked => { root.edit(); } }
        }
        HorizontalLayout {
            spacing: 8px;
            Text { text: @tr("Main" => "Start delay in seconds (0 = none):"); color: Palette.foreground; font-size: Family.body; vertical-alignment: center; }
            delay-edit := LineEdit { width: 80px; input-type: number; text: root.item.delay; }
            Button { text: @tr("Main" => "Set delay"); clicked => { root.set-delay(delay-edit.text.to-float()); } }
        }
        HorizontalLayout {
            alignment: start;
            Button {
                text: root.item.state == 0 ? @tr("Main" => "Disable at startup") : @tr("Main" => "Enable");
                primary: root.item.state == 0;
                clicked => { root.act(); }
            }
        }
    }

    Rectangle { height: 1px; background: Palette.border; }
}

component ServiceItem inherits VerticalLayout {
    in property <Svc> item;
    in property <bool> open;
    in property <int> status-filter;
    in property <int> rec-filter;
    in property <int> run-filter;
    callback toggle();
    callback act();
    callback run();
    spacing: 0px;

    Rectangle {
        height: 54px;
        background: head-ta.has-hover || root.open ? Palette.foreground.with-alpha(0.06) : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.item.unit; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                Text { text: root.item.description; color: Family.muted; font-size: Family.body; overflow: elide; }
            }
            Text {
                text: root.item.secs > 0 ? @tr("Main" => "{} s", root.item.secs) : "";
                width: 56px;
                color: Family.muted;
                font-size: Family.body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            // A chip that repeats an active filter is left out (as on Startup); every shown row has it.
            if root.rec-filter == 0 : VerticalLayout {
                alignment: center;
                width: 96px;
                Chip { text: root.item.essential ? @tr("Main" => "Essential") : @tr("Main" => "Optional"); tone: root.item.essential ? Family.warning : Family.info; }
            }
            if root.status-filter == 0 : VerticalLayout {
                alignment: center;
                width: 96px;
                Chip { text: root.item.enabled ? @tr("Main" => "Enabled") : @tr("Main" => "Disabled"); tone: root.item.enabled ? Family.success : Theme.muted; }
            }
            if root.run-filter == 0 : VerticalLayout {
                alignment: center;
                width: 80px;
                Chip { text: root.item.active ? @tr("Main" => "Running") : @tr("Main" => "Stopped"); tone: root.item.active ? Family.success : Theme.muted; }
            }
            VerticalLayout { alignment: center; Icon { source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; } }
        }
        head-ta := TouchArea { clicked => { root.toggle(); } }
    }

    if root.open : VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        if root.item.essential : Text {
            text: @tr("Main" => "Part of the system. Disabling it may break your session.");
            wrap: word-wrap;
            color: Family.danger;
        }
        Text {
            text: root.item.enabled ? @tr("Main" => "Starts at boot. Disabling it stops it from starting and, unless something depends on it, stops it now.")
                : @tr("Main" => "Disabled. Enable starts it now and at every boot.");
            wrap: word-wrap;
            color: Palette.foreground;
        }
        if root.item.active : Text { text: @tr("Main" => "Running now."); color: Family.muted; font-size: Family.body; }
        if root.item.background : Text {
            text: @tr("Main" => "Runs from a timer after boot, so it does not slow down the boot.");
            wrap: word-wrap;
            color: Family.muted;
            font-size: Family.body;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Button {
                text: root.item.enabled ? @tr("Main" => "Disable") : @tr("Main" => "Enable");
                primary: root.item.enabled;
                clicked => { root.act(); }
            }
            Button {
                text: root.item.active ? @tr("Main" => "Stop") : @tr("Main" => "Start");
                clicked => { root.run(); }
            }
        }
    }

    Rectangle { height: 1px; background: Palette.border; }
}

component AppItem inherits VerticalLayout {
    in property <AppRow> item;
    in property <bool> open;
    // The active Kind filter (0 = All): a chip that repeats it is left out, as on Startup.
    in property <int> rec-filter;
    callback toggle();
    callback act();
    spacing: 0px;

    Rectangle {
        height: 54px;
        background: head-ta.has-hover || root.open ? Palette.foreground.with-alpha(0.06) : transparent;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            // Always 32px wide so names line up whether or not the icon was found.
            AppIcon { source: root.item.icon; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.item.name; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                Text { text: root.item.id; color: Family.muted; font-size: Family.body; overflow: elide; }
            }
            Text {
                text: Theme.size(root.item.size-mb);
                width: 80px;
                color: Family.muted;
                font-size: Family.body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                text: root.item.last == "" ? "–" : root.item.last;
                width: 80px;
                color: Family.muted;
                font-size: Family.body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                width: 80px;
                NeutralBadge { text: root.item.source == 0 ? "Debian" : root.item.source == 1 ? "Flatpak" : "AppImage"; }
            }
            if root.rec-filter == 0 : VerticalLayout {
                alignment: center;
                width: 96px;
                Chip { text: root.item.essential ? @tr("Main" => "Essential") : @tr("Main" => "Optional"); tone: root.item.essential ? Family.warning : Family.info; }
            }
            VerticalLayout { alignment: center; Icon { source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; } }
        }
        head-ta := TouchArea { clicked => { root.toggle(); } }
    }

    if root.open : VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-bottom: 12px;
        spacing: 8px;
        if root.item.essential : Text {
            text: @tr("Main" => "Part of the system. Removing it may break your session.");
            wrap: word-wrap;
            color: Family.danger;
        }
        Text {
            text: root.item.last == "" ? @tr("Main" => "Last data activity: unknown. It keeps no settings folder, so there is no way to tell if you use it.")
                : @tr("Main" => "Last data activity: {}. This is when its settings or data last changed, not proof of use.", root.item.last);
            wrap: word-wrap;
            color: Palette.foreground;
        }
        if root.item.stale : Text {
            text: @tr("Main" => "Its data has not changed for a long time. You may not use it any more.");
            wrap: word-wrap;
            color: Family.warning;
        }
        if root.item.group >= 0 : Text {
            text: @tr("Main" => "{} installed apps are {}. You may not need all of them.", root.item.group-count, Tr.group(root.item.group));
            wrap: word-wrap;
            color: Family.warning;
        }
        if !root.item.manual : Text {
            text: @tr("Main" => "Installed automatically as a dependency of another package.");
            wrap: word-wrap;
            color: Family.muted;
            font-size: Family.body;
        }
        HorizontalLayout {
            alignment: start;
            DangerButton {
                text: root.item.source == 2 ? @tr("Main" => "Move to Trash") : @tr("Main" => "Uninstall");
                clicked => { root.act(); }
            }
        }
    }

    Rectangle { height: 1px; background: Palette.border; }
}

component LeftItem inherits VerticalLayout {
    in property <Left> item;
    callback act();
    callback open();
    spacing: 0px;

    Rectangle {
        height: 54px;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.item.id; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                Text {
                    text: root.item.last == "" ? @tr("Main" => "Last data activity: unknown") : @tr("Main" => "Last data activity: {}", root.item.last);
                    color: Family.muted;
                    font-size: Family.body;
                }
            }
            Text {
                text: Theme.size(root.item.size-mb);
                width: 80px;
                color: Family.muted;
                font-size: Family.body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            VerticalLayout { alignment: center; IconButton { source: @image-url("icons/folder.svg"); label: @tr("Main" => "Open folder"); clicked => { root.open(); } } }
            VerticalLayout { alignment: center; Button { text: @tr("Main" => "Move to Trash"); clicked => { root.act(); } } }
        }
    }

    Rectangle { height: 1px; background: Palette.border; }
}

// A row of the Storage page: a path or name, the last change and a button with its own label.
component StoreItem inherits VerticalLayout {
    in property <Left> item;
    in property <string> label;
    in property <bool> can-open;
    // `item.last` is a deletion date (old Trash entries) instead of the last change.
    in property <bool> deleted;
    in property <bool> calm;
    callback act();
    callback open();
    spacing: 0px;

    Rectangle {
        height: 54px;
        HorizontalLayout {
            padding-left: 0px;
            padding-right: 12px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.item.id; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                if root.item.last != "" : Text {
                    text: root.deleted ? @tr("Main" => "Deleted: {}", root.item.last) : @tr("Main" => "Last change: {}", root.item.last);
                    color: Family.muted;
                    font-size: Family.body;
                }
                if root.item.used != "" : Text {
                    text: @tr("Main" => "Used by: {}", root.item.used);
                    color: Family.muted;
                    font-size: Family.body;
                    overflow: elide;
                }
            }
            Text {
                text: Theme.size(root.item.size-mb);
                width: 80px;
                color: Family.muted;
                font-size: Family.body;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if root.can-open : VerticalLayout { alignment: center; IconButton { source: @image-url("icons/folder.svg"); label: @tr("Main" => "Open folder"); clicked => { root.open(); } } }
            // An empty label makes the row read-only. Outlined red like Uninstall: the action is permanent or removes data.
            if root.label != "" && root.item.keep == 0 : VerticalLayout { alignment: center; DangerButton { text: root.label; calm: root.calm; clicked => { root.act(); } } }
            if root.item.keep != 0 : VerticalLayout {
                alignment: center;
                width: 170px;
                Chip {
                    text: root.item.keep == 5 ? @tr("Main" => "Original, kept")
                        : root.item.keep == 1 ? @tr("Main" => "Newest, kept")
                        : root.item.keep == 2 ? @tr("Main" => "Used by a game, kept")
                        : root.item.keep == 4 ? @tr("Main" => "Steam default, kept")
                        : @tr("Main" => "Managed by Steam");
                    tone: root.item.keep == 3 ? Family.muted : Family.success;
                }
            }
        }
    }
    Rectangle { height: 1px; background: Palette.border; }
}

// A list of StoreItem rows: the first 3, and a link to show the rest.
component StoreList inherits VerticalLayout {
    in property <[Left]> items;
    in property <string> label;
    in property <bool> can-open;
    in property <bool> deleted;
    in property <bool> calm;
    callback act(Left);
    callback open(Left);
    property <bool> all;
    spacing: 0px;

    // Spacing 0 and padded rows, so a hidden row leaves no gap.
    for it[i] in root.items : VerticalLayout {
        if i < 3 || root.all : VerticalLayout {
            padding-bottom: 6px;
            StoreItem { item: it; label: root.label; can-open: root.can-open; deleted: root.deleted; calm: root.calm; act => { root.act(it); } open => { root.open(it); } }
        }
    }
    if root.items.length > 3 : Rectangle {
        height: 24px;
        HorizontalLayout {
            alignment: start;
            spacing: 4px;
            Text {
                text: root.all ? @tr("Main" => "Show fewer") : @tr("Main" => "Show {} more", root.items.length - 3);
                color: Family.info;
                font-size: Family.body;
                vertical-alignment: center;
            }
            VerticalLayout { alignment: center; Icon { source: root.all ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); tone: Family.info; width: 14px; height: 14px; } }
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.all = !root.all; } }
    }
}

// A number with its label, shown at the top of a page before the detail.
component Tile inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <color> tone: Palette.foreground;
    in property <bool> link;
    // Optional; only the dashboard tiles set it.
    in property <image> icon;
    in property <color> icon-tone: Palette.foreground.with-alpha(0.62);
    callback clicked();
    // Equal columns: a row of tiles shares the width instead of sizing each tile to its text.
    horizontal-stretch: 1;
    preferred-width: 0px;
    border-width: 1px;
    border-color: root.link && touch.has-hover ? Palette.accent-background : Palette.border;
    border-radius: Family.radius;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        if root.icon.width > 0 : VerticalLayout { alignment: start; padding-top: 4px; Icon { source: root.icon; tone: root.icon-tone; width: 18px; height: 18px; } }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.value; font-size: Family.page-title; font-weight: Family.page-weight; color: root.tone; overflow: elide; }
            Text { text: root.label; font-size: Family.body; color: Family.muted; overflow: elide; }
        }
    }
    // Only tiles with `link` react, so the other dashboards keep plain tiles.
    touch := TouchArea { enabled: root.link; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// `frac` is 0 to 1.
component Bar inherits Rectangle {
    in property <float> frac;
    in property <color> tone: Family.success;
    height: 8px;
    border-radius: 4px;
    background: Palette.foreground.with-alpha(0.12);
    Rectangle { x: 0px; width: parent.width * Math.clamp(root.frac, 0, 1); height: parent.height; border-radius: 4px; background: root.tone; }
}

// A titled group with an optional one-line help text and a figure on the right. `collapsible` sections start closed
// and their header opens them; the rest is always shown.
component Section inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> total;
    in property <image> icon;
    // Space clean-ups: 0 safe, 1 almost safe, 2 must analyze (see `Theme.tier-icon`); -1 none.
    in property <int> tier: -1;
    in property <bool> collapsible;
    in property <bool> link;
    // "Nothing here" sentence: shown on the header line (green check) and the body and `sub` collapse, so an empty
    // group costs one line instead of a card.
    in property <string> empty;
    // Dashboard cards only: a status dot before the title and an "Open" hint at the right.
    in property <bool> status;
    in property <color> dot: Theme.muted;
    // Optional status chip and button in the header row, next to the title.
    in property <string> badge;
    in property <color> badge-tone: Theme.muted;
    in property <string> action;
    in property <bool> action-enabled: true;
    // The one main action of the page is drawn filled.
    in property <bool> action-primary;
    // A second, quiet header button (for example Hide).
    in property <string> action2;
    callback action-clicked();
    callback action2-clicked();
    callback clicked();
    in-out property <bool> open: !root.collapsible;
    border-width: 1px;
    border-color: root.link && whole.has-hover ? Palette.accent-background : Palette.border;
    border-radius: Family.radius;
    height: inner.preferred-height;
    inner := VerticalLayout {
        padding: 12px;
        spacing: root.open && root.empty == "" ? 8px : 0px;
        HorizontalLayout {
            spacing: 10px;
            if root.status : VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.dot; } }
            if root.icon.width > 0 : VerticalLayout { alignment: center; Icon { source: root.icon; width: 18px; height: 18px; } }
            if root.tier >= 0 : VerticalLayout { alignment: center; Icon { source: Theme.tier-icon(root.tier); tone: Theme.tier-tone(root.tier); width: 18px; height: 18px; } }
            Text { text: root.title; font-size: Family.title; font-weight: Family.section-weight; color: Palette.foreground; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
            if root.empty != "" : HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 2;
                alignment: end;
                VerticalLayout { alignment: center; Icon { source: @image-url("icons/circle-check.svg"); width: 16px; height: 16px; tone: Family.success; } }
                Text { text: root.empty; color: Family.success; font-size: Family.body; vertical-alignment: center; wrap: word-wrap; }
            }
            if root.badge != "" : VerticalLayout { alignment: center; Chip { text: root.badge; tone: root.badge-tone; } }
            Text { text: root.empty == "" ? root.total : ""; color: Family.muted; vertical-alignment: center; }
            if root.action2 != "" : Button { text: root.action2; clicked => { root.action2-clicked(); } }
            if root.action != "" : Button { text: root.action; primary: root.action-primary; enabled: root.action-enabled; clicked => { root.action-clicked(); } }
            if root.status : HorizontalLayout {
                spacing: 2px;
                Text { text: @tr("Main" => "Open"); color: Family.info; font-size: Family.body; vertical-alignment: center; }
                VerticalLayout { alignment: center; Icon { source: @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; tone: Family.info; } }
            }
            if root.collapsible : Text { text: root.open ? @tr("Main" => "Hide") : @tr("Main" => "Show"); color: Family.info; font-size: Family.body; vertical-alignment: center; }
        }
        if root.sub != "" && root.empty == "" : Text { text: root.sub; wrap: word-wrap; color: Family.muted; font-size: Family.body; }
        // @children cannot sit in an `if`, so a closed section is clipped to nothing instead.
        Rectangle {
            clip: true;
            visible: root.open && root.empty == "";
            height: root.open && root.empty == "" ? body.preferred-height : 0px;
            body := VerticalLayout { spacing: 6px; @children }
        }
    }
    TouchArea {
        // A header `action` button would sit under this, so the two do not combine.
        enabled: root.collapsible && root.action == "";
        height: 36px;
        y: 0px;
        clicked => { root.open = !root.open; }
    }
    // The whole card opens its page; disabled otherwise so it never steals text selection.
    whole := TouchArea { enabled: root.link; mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// The link back to a dashboard, shown before the title of a page opened from it.
component Back inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: label.preferred-width + 16px;
    // Same label as the sidebar item otherwise, so a screen reader needs the word "back".
    accessible-role: button;
    accessible-label: @tr("Main" => "Back to {}", root.text);
    Icon { x: 0px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; source: @image-url("icons/chevron-left.svg"); tone: Family.info; }
    label := Text { x: 16px; text: root.text; color: Family.info; font-size: Family.body; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

// A label with its value, for the System page. The value wraps: CPU and GPU names are long.
component InfoLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    if root.label != "" : Text { text: root.label; width: 170px; color: Family.muted; vertical-alignment: top; }
    Text { text: root.value; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; vertical-alignment: top; }
}

// The "nothing to do here" line: a green check and the sentence.
component Empty inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    VerticalLayout { alignment: start; padding-top: 1px; Icon { source: @image-url("icons/circle-check.svg"); width: 16px; height: 16px; tone: Family.success; } }
    Text { text: root.text; color: Family.success; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
}

// A quiet "what is this?" link that opens a tinted, selectable panel with a longer explanation. Click rather than hover
// because the text is paragraphs, must be selectable and must work from the keyboard. Put it in a card body, never
// inside a `link` Section (its whole-card TouchArea would take the click).
component LearnMore inherits VerticalLayout {
    in property <string> label;
    in property <string> text;
    in-out property <bool> open;
    spacing: 6px;
    HorizontalLayout {
        alignment: start;
        link := Rectangle {
            width: line.preferred-width;
            height: 22px;
            accessible-role: button;
            accessible-label: root.label;
            accessible-expanded: root.open;
            accessible-action-default => { root.open = !root.open; }
            if fs.has-focus : Rectangle { x: -3px; y: -2px; width: parent.width + 6px; height: parent.height + 4px; border-width: 2px; border-color: Palette.accent-background; border-radius: 4px; }
            line := HorizontalLayout {
                spacing: 6px;
                VerticalLayout { alignment: center; Icon { source: @image-url("icons/info.svg"); width: 16px; height: 16px; tone: Family.info; } }
                Text { text: root.label; color: Family.info; font-size: Family.body; vertical-alignment: center; }
                VerticalLayout { alignment: center; Icon { source: root.open ? @image-url("icons/chevron-down.svg") : @image-url("icons/chevron-right.svg"); width: 14px; height: 14px; tone: Family.info; } }
            }
            fs := FocusScope {
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") { root.open = !root.open; return accept; }
                    return reject;
                }
                TouchArea { mouse-cursor: pointer; clicked => { fs.focus(); root.open = !root.open; } }
            }
        }
    }
    if root.open : Rectangle {
        background: Palette.foreground.with-alpha(0.05);
        border-radius: 6px;
        height: panel.preferred-height + 20px;
        panel := TextInput { x: 10px; y: 10px; width: parent.width - 20px; read-only: true; wrap: word-wrap; font-size: Family.body; color: Palette.foreground; text: root.text; }
    }
}

// A mounted filesystem with its usage bar; the bar turns amber at 70% and red at 90%.
component MountRow inherits HorizontalLayout {
    in property <Mnt> m;
    spacing: 10px;
    height: 22px;
    Text { text: root.m.path; width: 170px; overflow: elide; color: Palette.foreground; font-size: Family.body; vertical-alignment: center; }
    VerticalLayout { alignment: center; horizontal-stretch: 1; Bar { frac: root.m.pct / 100; tone: root.m.pct >= 90 ? Family.danger : root.m.pct >= 70 ? Family.warning : Family.success; } }
    Text { text: @tr("Main" => "{} of {} GB, {}%", root.m.used-gb, root.m.total-gb, root.m.pct); width: 230px; horizontal-alignment: right; color: root.m.pct >= 90 ? Family.danger : Family.muted; font-size: Family.body; vertical-alignment: center; }
}


export component Main inherits Window {
    title: "FastCheckup";
    min-width: 400px;
    min-height: 300px;
    preferred-width: 960px;
    preferred-height: 680px;
    background: Palette.background;

    in property <[Row]> rows;
    in property <[HistoryRow]> history;
    in property <string> history-text;
    in property <[Svc]> services;
    in property <bool> svc-busy;
    in property <bool> boot-busy;
    in property <float> boot-total;
    in property <[Phase]> phases;
    in property <[Link]> chain;
    in property <Grub> grub;
    in property <string> bios-board;
    // Overview "Right now", sampled on every visit (about a second). `perf-level` 0 = not sampled yet;
    // `perf-cause`: 0 none, 1 memory, 2 processor, 3 disk.
    in property <bool> perf-busy;
    in property <int> perf-level;
    in property <int> perf-cause;
    in property <int> perf-uptime-s;
    in property <int> perf-cpus;
    in property <float> perf-load;
    in property <float> perf-mem-total-mb;
    in property <float> perf-mem-avail-mb;
    in property <float> perf-swap-total-mb;
    in property <float> perf-swap-used-mb;
    in property <[PerfApp]> perf-apps;
    // Disk health page, scanned on the first visit. `disk-warning` also shows a note on the Boot page.
    in property <bool> health-busy;
    in property <bool> disk-warning;
    in property <string> other-problems;
    in property <string> crashes;
    in property <string> mem-text;
    // No swap and no watcher, with a freeze or an out-of-memory kill on record: worth a look.
    in property <bool> mem-warning;
    // Only the snapshot script sets it (STATE=expanded): opens the swap/zram explanation.
    in-out property <bool> mem-info-open;
    in property <int> backup-state;
    in property <string> backup-latest;
    in property <[Disk]> disks;
    in-out property <bool> health-scanned;
    // System page, scanned on the first visit. `sys-report` is the same data as plain text for "Copy all".
    in property <bool> sys-busy;
    in property <[SysGroup]> sys-groups;
    // Only the snapshot script sets it (STATE=bottom), to see the end of a long page (System, Disk health).
    in property <bool> scroll-bottom;
    in property <string> sys-report;
    in-out property <bool> sys-scanned;
    // Security page, scanned on the first visit.
    in property <bool> security-busy;
    in property <[Finding]> findings;
    // The first three (the worst), for the Safety dashboard.
    in property <[Finding]> top-findings;
    // Findings split per topic (index = `Finding.group`) and the topics to show, so no empty wrappers add spacing.
    in property <[[Finding]]> group-findings;
    in property <[int]> shown-groups;
    // The scan already knows ufw is off, so asking for the password to read its rules would tell nothing new.
    in property <bool> fw-off;
    // How many findings per level, for the tiles.
    in property <int> sec-suspicious;
    in property <int> sec-look;
    in property <int> sec-info;
    in property <[SecTool]> sec-tools;
    in-out property <bool> security-scanned;
    // Firewall rules, read on demand (administrator password). `fw-state`: 0 not read, 1 reading, 2 done, 3 failed.
    in property <int> fw-state;
    in property <string> fw-text;
    // Filled by Rust when a preview is ready, then the dialog opens.
    in-out property <bool> boot-confirming;
    in-out property <int> boot-action;
    in-out property <int> boot-secs;
    in-out property <string> boot-diff;
    in-out property <string> boot-cmds;
    // Set by Rust once the precheck of a disable is done, then the dialog opens.
    in-out property <Svc> svc-pending;
    in-out property <bool> svc-confirming;
    in-out property <string> svc-hint;
    in-out property <string> svc-note;
    in-out property <bool> svc-now: true;
    in property <[AppRow]> apps;
    in property <[Left]> leftovers;
    // Startup entries whose program is gone. `Left.id` = file name, `used` = name, `path` = command.
    in property <[Left]> stale-startup;
    in property <[Left]> home-data;
    in property <[Kern]> kernels;
    // Storage page. `store-scanned` makes the first visit start the scan, so the app starts without walking $HOME.
    in property <[Mnt]> mounts;
    in property <[Left]> top-folders;
    in property <[Left]> big-files;
    in property <[Left]> games;
    in property <[Left]> old-versions;
    // Build folders: `old-builds` were not touched for `old-days` days (almost safe), `builds` are the newer ones.
    in property <[Left]> builds;
    in property <[Left]> old-builds;
    // Home Trash entries deleted more than `old-days` days ago (`Left.last` = deletion date).
    in property <[Left]> old-trash;
    in property <[Left]> installers;
    in property <[Left]> caches;
    in property <[Dock]> docker;
    in property <int> trash-count;
    in property <float> trash-mb;
    in property <float> journal-mb;
    in property <float> apt-mb;
    // Timeshift: snapshot count and the date of the oldest; `snap-set-up` is true when its config exists.
    // Duplicate files, found on demand: each group starts with its original (`keep` 5), then the copies. A copy's `path` is its original.
    in property <[Left]> dups;
    in property <bool> dup-busy;
    in property <bool> dup-scanned;
    in property <int> snap-count;
    in property <string> snap-oldest;
    in property <bool> snap-set-up;
    // Minutes since the last Storage, Disk health and Security scan finished; -1 until the first one. Rust sets 0 when a scan ends, the Timer counts up.
    in-out property <int> store-ago: -1;
    in-out property <int> health-ago: -1;
    in-out property <int> security-ago: -1;
    Timer {
        interval: 60s;
        running: true;
        triggered => {
            if (root.store-ago >= 0) { root.store-ago += 1; }
            if (root.health-ago >= 0) { root.health-ago += 1; }
            if (root.security-ago >= 0) { root.security-ago += 1; }
        }
    }
    in property <bool> store-busy;
    in-out property <bool> store-scanned;
    in property <bool> app-busy;
    // What is no longer needed, as comma-separated names ("" = nothing) and the size in MB.
    in property <string> rt-list;
    in property <float> rt-mb;
    in property <string> auto-list;
    in property <float> auto-mb;
    in property <string> res-list;
    in property <float> res-mb;
    // Set by Rust once the plan of an action is ready, then the dialog opens. `app-action`: 0 uninstall,
    // 1 move leftover data to the Trash, 2 remove unused Flatpak runtimes,
    // 3 apt autoremove, 4 delete the settings of removed packages, 5 remove an old kernel (`app-id` = its version),
    // 6 build folder to the Trash (`app-id` = its path), 7 installer to the Trash, 8 empty the Trash, 9 clear a cache,
    // 10 shrink the journal, 11 Docker build cache, 12 Docker stopped containers and untagged images.
    // 13 old tool version to the Trash, 14 stale startup entry, 15 settings of an app that looks gone, 16 APT package
    // files, 17 duplicate, 18 old Trash entry deleted for good.
    in-out property <bool> app-confirming;
    in-out property <int> app-action;
    in-out property <int> app-source;
    in-out property <string> app-id;
    in-out property <string> app-cmd;
    in-out property <float> app-freed;
    in-out property <string> app-note;
    // Raw error from the system, shown after a translated prefix.
    in-out property <string> error;
    callback apply(string, string, int);
    callback rescan();
    callback edit(string);
    callback set-delay(string, int);
    // Slint has no substring test, so Rust does it (case-insensitive).
    pure callback contains(string, string) -> bool;
    callback boot-rescan();
    callback health-rescan();
    callback sys-rescan();
    callback perf-rescan();
    callback security-rescan();
    callback firewall-check();
    callback smart-check(int, string);
    callback boot-preview(int);
    callback boot-restore-preview();
    callback boot-apply(int, int);
    callback svc-rescan();
    callback svc-precheck(Svc);
    callback svc-apply(string, bool, bool);
    callback svc-run(string, bool);
    callback app-rescan();
    callback app-resort();
    // 0 size, 1 name, 2 date (see `sort_apps` in main.rs).
    in-out property <int> app-sort;
    // Reverses the chosen order (second click on the same chip).
    in-out property <bool> app-sort-flip;
    // Size and Date start high-to-low (▼), Name starts A to Z (▲); flipping turns the arrow.
    pure function sort-icon(i: int) -> image {
        return root.app-sort != i ? @image-url("") : (i == 1) != root.app-sort-flip ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg");
    }
    callback app-precheck(int, int, string, float);
    callback app-apply(int, int, string);
    callback storage-rescan();
    callback storage-stop();
    // Bulk clean-up of a tier (0 safe, 1 almost safe): Rust fills `bulk` and opens the dialog; each tick goes back to
    // Rust, which recomputes the totals and the command lines.
    callback bulk-plan(int);
    callback bulk-toggle(int);
    callback bulk-apply();
    in-out property <bool> bulk-confirming;
    in-out property <int> bulk-tier;
    in property <[BulkRow]> bulk;
    in property <string> bulk-cmds;
    // What the ticked rows with a `detail` remove, one sentence per row (built by Rust through `Tr`).
    in property <string> bulk-detail;
    in property <float> bulk-mb;
    in property <int> bulk-count;
    // A ticked row needs the administrator password / may make Flatpak ask for it.
    in property <bool> bulk-root;
    in property <bool> bulk-flatpak;
    in-out property <bool> bulk-cmds-open;
    // "Almost safe" means older than this many days (Preferences); Rust saves it and rescans when Preferences closes.
    in-out property <int> old-days: 90;
    callback set-old-days(int);
    // Off by default: emptying the Trash (and deleting old Trash entries) cannot be undone.
    in-out property <bool> allow-empty-trash;
    callback set-allow-empty-trash(bool);
    callback prefs-closed();
    pure function bulk-label(action: int, id: string) -> string {
        return action == 9 ? @tr("Main" => "Cache: {}", id)
            : action == 6 ? @tr("Main" => "Build folder: {}", id)
            : action == 7 ? @tr("Main" => "Installer: {}", id)
            : action == 13 ? @tr("Main" => "Old tool version: {}", id)
            : action == 18 ? @tr("Main" => "Trash entry: {}", id)
            : action == 2 ? @tr("Main" => "Unused Flatpak runtimes")
            : action == 3 ? @tr("Main" => "Packages nothing needs ({} packages)", id)
            : action == 10 ? @tr("Main" => "System journal, keeping the newest 100 MB")
            : action == 11 ? @tr("Main" => "Docker build cache")
            : @tr("Main" => "Downloaded package files");
    }
    callback dup-find();
    // Opens the data folder of a leftover Flatpak (0) or a cache (1) in the file manager.
    callback open-folder(int, string);
    // Opens a folder, or the folder of a file, from the Storage lists in the file manager.
    callback open-path(string);
    // A file in ~/.config/autostart (by name); opens that folder.
    callback open-autostart(string);

    // Preferences (appearance, language, About). `lang-index`: 0 system default, 1 English, 2 Português (Brasil).
    in-out property <bool> menu-open;
    in-out property <bool> about-open;
    // Flatpak whose host copy could not start (host.rs): the scanners see only the sandbox, and Overview says so.
    in-out property <bool> sandboxed;
    // Root-only checks (core/admin.rs): `admin-state` 0 not run, 1 asking, 2 done, 3 failed (`admin-error`). The
    // Overview offers them unless the app already runs as root or the notice was hidden.
    in-out property <int> admin-state;
    in property <string> admin-error;
    in-out property <bool> admin-hidden;
    in property <bool> is-root;
    callback admin-run();
    in-out property <int> lang-index;
    // 0 follows the system, 1 light, 2 dark (settings.theme). Palette.color-scheme is the only palette property an app
    // can set; the colors still follow the system accent.
    in-out property <int> theme-index;
    changed theme-index => {
        Palette.color-scheme = root.theme-index == 1 ? ColorScheme.light
            : root.theme-index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }
    in property <string> version;
    callback set-language(int);
    callback set-theme(int);
    callback open-url(string);

    // `in-out` so `FASTCHECKUP_PAGE` can open a page directly (scripts/ui-snapshot.sh).
    // 0 Startup, 1 Services, 2 Boot, 3 Apps, 5 History, 7 Disk health, 8 Security, 13 System, and the pages that
    // group them: 9 Overview, 10 Space (disks and every clean-up, by tier), 11 Safety (7, 8), 12 Speed (0, 1, 2).
    // 4 and 6 are free: Leftovers and Storage moved into Space.
    in-out property <int> page: 9;
    // Totals for the dashboards, set by Rust from the lists the scans filled.
    // What the bulk clean-up of each tab would free. `safe-scan-mb` is from the Storage scan (caches, APT files, journal,
    // Docker build cache); the Leftovers part (Flatpak runtimes, autoremove) is added live as it rescans.
    in property <float> safe-scan-mb;
    in property <float> almost-free-mb;
    property <float> safe-free-mb: root.safe-scan-mb + root.rt-mb + root.auto-mb;
    in property <int> fullest-pct;
    // Area status for the sidebar dots and the Overview cards (see `Theme.level-color`). Problems show as soon as any
    // part reports one; "fine" needs every part scanned. Space reads the disks only, not Leftovers. The 30 s and 60 s
    // boot limits are a rule of thumb.
    property <bool> all-disks;
    // Storage group: 0 safe, 1 almost safe (older than `old-days`), 2 must analyze (one by one), 3 look only. The Space
    // dashboard sets it before opening the page.
    in-out property <int> store-group;
    // Set by the snapshot script only: opens every disk's partition list.
    in-out property <bool> show-all-parts;
    property <int> health-level: !root.health-scanned ? 0 : root.disk-warning ? 3 : 1;
    property <int> security-level: !root.security-scanned ? 0 : root.sec-suspicious > 0 ? 3 : root.sec-look > 0 ? 2 : 1;
    property <int> space-level: !root.store-scanned ? 0 : root.fullest-pct >= 90 ? 3 : root.fullest-pct >= 70 ? 2 : 1;
    // Speed also carries the memory safety net (it moved here from Disk health): a warning there makes it "worth a look".
    property <int> boot-level: root.boot-total <= 0 ? 0 : root.boot-total >= 60 ? 3 : root.boot-total >= 30 ? 2 : 1;
    property <int> speed-level: Math.max(root.boot-level, root.health-scanned && root.mem-warning ? 2 : 0);
    property <int> safety-level: Math.max(root.health-level, root.security-level) >= 2 ? Math.max(root.health-level, root.security-level)
        : (root.health-level == 0 || root.security-level == 0) ? 0 : 1;

    // Opens a page and starts the scans it needs on the first visit (the dashboards ask for the pages they summarise).
    function go(p: int) {
        root.page = p;
        // The search box of the page left behind is gone; keep typed letters going to the new page.
        content-keys.focus();
        if p == 9 && !root.perf-busy { root.perf-rescan(); }
        if p == 10 && !root.store-scanned { root.store-scanned = true; root.storage-rescan(); }
        if (p == 7 || p == 11 || p == 12) && !root.health-scanned { root.health-scanned = true; root.health-rescan(); }
        if p == 13 && !root.sys-scanned { root.sys-scanned = true; root.sys-rescan(); }
        if (p == 8 || p == 11) && !root.security-scanned { root.security-scanned = true; root.security-rescan(); }
    }

    pure function size(mb: float) -> string {
        return Theme.size(mb);
    }

    // 0 not checked, 1 healthy, 2 warning, 3 failing.
    pure function disk-level(d: Disk) -> int {
        return d.state == 2 ? 3
            : d.state != 1 ? 0
            : d.nvme ? (d.uncorrectable > 0 || d.used >= 95 || (d.spare >= 0 && d.spare <= 5) ? 3 : d.used >= 80 || (d.spare >= 0 && d.spare <= 20) ? 2 : 1)
            : (d.pending + d.uncorrectable > 0 ? 3 : d.reallocated > 0 || d.crc > 0 ? 2 : 1);
    }
    in-out property <string> open-file;
    in-out property <bool> confirming;
    in-out property <Row> pending;
    // Status: 0 all, 1 enabled, 2 disabled. Recommendation: 0 all, 1 optional, 2 essential.
    property <int> status-filter: 1;
    property <int> rec-filter: 1;
    init => { content-keys.focus(); }
    // Last letter typed outside a search box and a counter that ticks per letter (see SearchBox).
    property <string> typed;
    property <int> typed-seq;
    property <string> query;
    property <string> svc-query;
    in-out property <string> open-unit;
    property <int> svc-status-filter: 1;
    property <int> svc-rec-filter: 1;
    // 0 all, 1 running, 2 stopped.
    property <int> svc-run-filter;
    property <string> app-query;
    in-out property <string> open-app;
    // Source: 0 all, 1 Debian, 2 Flatpak, 3 AppImage. Recommendation as above.
    property <int> app-source-filter;
    property <int> app-rec-filter: 1;

    pure function shown(r: Row) -> bool {
        return (root.status-filter == 0 || (root.status-filter == 1) == (r.state == 0))
            && (root.rec-filter == 0 || (root.rec-filter == 2) == r.essential)
            && root.contains(r.name + " " + r.comment + " " + r.exec + " " + r.file, root.query);
    }

    pure function svc-shown(r: Svc) -> bool {
        return (root.svc-status-filter == 0 || (root.svc-status-filter == 1) == r.enabled)
            && (root.svc-rec-filter == 0 || (root.svc-rec-filter == 2) == r.essential)
            && (root.svc-run-filter == 0 || (root.svc-run-filter == 1) == r.active)
            && root.contains(r.unit + " " + r.description, root.svc-query);
    }

    pure function app-shown(r: AppRow) -> bool {
        return (root.app-source-filter == 0 || root.app-source-filter == r.source + 1)
            && (root.app-rec-filter == 0 || (root.app-rec-filter == 2) == r.essential)
            && root.contains(r.name + " " + r.id, root.app-query);
    }

    // Holds the report for "Copy all" (no clipboard crate). Outside every layout: a 0-wide child inside one caps the
    // layout's maximum width and shrinks the whole window. Zero size rather than hidden so it can still copy.
    copy-box := TextInput { x: 0px; y: 0px; width: 0px; height: 0px; read-only: true; text: root.sys-report; }

    HorizontalLayout {
        Rectangle {
            width: 184px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 10px;
                spacing: 4px;
                alignment: start;
                // Same header as FastHello: app icon, name, the Preferences button.
                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 4px;
                    Image { source: @image-url("../../../packaging/io.github.evandro777.FastCheckup.svg"); width: 24px; height: 24px; }
                    Text { text: "FastCheckup"; font-weight: Family.section-weight; vertical-alignment: center; horizontal-stretch: 1; }
                    MenuButton { label: @tr("Main" => "Preferences"); clicked => { root.menu-open = true; } }
                }
                Rectangle { height: 8px; }
                // A page opened from a dashboard keeps that dashboard highlighted.
                NavItem { text: @tr("Main" => "Overview"); icon: @image-url("icons/overview.svg"); active: root.page == 9; clicked => { root.go(9); } }
                NavItem { text: @tr("Main" => "Speed"); icon: @image-url("icons/gauge.svg"); level: root.speed-level; active: root.page == 12 || root.page <= 2; quiet: root.page <= 2; clicked => { root.go(12); } }
                // The pages of the open group, so the detail pages can be reached (and told apart) from the sidebar.
                if root.page == 12 || root.page <= 2 : VerticalLayout {
                    spacing: 2px;
                    NavItem { sub: true; text: @tr("Main" => "Startup"); active: root.page == 0; clicked => { root.go(0); } }
                    NavItem { sub: true; text: @tr("Main" => "Services"); active: root.page == 1; clicked => { root.go(1); } }
                    NavItem { sub: true; text: @tr("Main" => "Boot"); active: root.page == 2; clicked => { root.go(2); } }
                }
                NavItem { text: @tr("Main" => "Space"); icon: @image-url("icons/hard-drive.svg"); level: root.space-level; active: root.page == 10; clicked => { root.go(10); } }
                NavItem { text: @tr("Main" => "Safety"); icon: @image-url("icons/shield.svg"); level: root.safety-level; active: root.page == 11 || root.page == 7 || root.page == 8; quiet: root.page == 7 || root.page == 8; clicked => { root.go(11); } }
                if root.page == 11 || root.page == 7 || root.page == 8 : VerticalLayout {
                    spacing: 2px;
                    NavItem { sub: true; text: @tr("Main" => "Disk health"); active: root.page == 7; clicked => { root.go(7); } }
                    NavItem { sub: true; text: @tr("Main" => "Security"); active: root.page == 8; clicked => { root.go(8); } }
                }
                NavItem { text: @tr("Main" => "Apps"); icon: @image-url("icons/app-window.svg"); active: root.page == 3; clicked => { root.go(3); } }
                NavItem { text: @tr("Main" => "System"); icon: @image-url("icons/info.svg"); active: root.page == 13; clicked => { root.go(13); } }
                NavItem { text: @tr("Main" => "History"); icon: @image-url("icons/history.svg"); active: root.page == 5; clicked => { root.go(5); } }
            }
        }

        // Catches the keys no widget handled: a letter or digit on a page with a search box starts a search.
        content-keys := FocusScope {
          key-pressed(event) => {
            if ((root.page == 0 || root.page == 1 || root.page == 3) && !event.modifiers.control && !event.modifiers.alt
                && !event.modifiers.meta && event.text.character-count == 1
                && (event.text.to-lowercase() != event.text.to-uppercase() || event.text.is-float())) {
                root.typed = event.text;
                root.typed-seq += 1;
                return accept;
            }
            return reject;
          }
        VerticalLayout {
            padding: 16px;
            // No right padding inside the ScrollViews: headers and lists end on the same edge and the scrollbar overlays
            // the rows, whose own 12px right padding keeps it off the chevrons.
            spacing: 12px;

            if root.error != "" : Rectangle {
                background: Family.danger;
                border-radius: 6px;
                height: 40px;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 6px;
                    spacing: 8px;
                    Text { text: @tr("Main" => "Could not apply the change: {}", root.error); color: white; vertical-alignment: center; overflow: elide; }
                    CloseButton { label: @tr("Main" => "Dismiss"); clicked => { root.error = ""; } }
                }
            }

            if root.page == 0 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Back { text: @tr("Main" => "Speed"); clicked => { root.go(12); } }
                    Text { text: @tr("Main" => "Startup"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    Rectangle { }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; clicked => { root.rescan(); } }
                }
                Text {
                    text: @tr("Main" => "Apps that start when you log in. FastCheckup never changes the system files; it adds an override in your own folder.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                if root.rows.length == 0 : Text { text: @tr("Main" => "No startup apps found."); color: Family.muted; }
                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Status"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), @tr("Main" => "Enabled"), @tr("Main" => "Disabled")]; selected <=> root.status-filter; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Kind"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), @tr("Main" => "Optional"), @tr("Main" => "Essential")]; selected <=> root.rec-filter; }
                    }
                    VerticalLayout { alignment: end; horizontal-stretch: 1; SearchBox { text <=> root.query; placeholder: @tr("Main" => "Search"); typed: root.typed; seq: root.typed-seq; min-width: 60px; } }
                }
                ScrollView {
                    VerticalLayout {
                        // Without this, a short (filtered) list stretches its rows to fill the window.
                        alignment: start;
                        // The empty wrapper has zero height, so filtered-out rows leave no gap.
                        for r in root.rows : VerticalLayout {
                            if root.shown(r) : RowItem {
                                item: r;
                                status-filter: root.status-filter;
                                rec-filter: root.rec-filter;
                                open: root.open-file == r.file;
                                toggle => { root.open-file = root.open-file == r.file ? "" : r.file; }
                                edit => { root.edit(r.source); }
                                set-delay(secs) => { root.set-delay(r.file, secs); }
                                act => { root.pending = r; root.confirming = true; }
                            }
                        }
                    }
                }
            }

            if root.page == 1 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Back { text: @tr("Main" => "Speed"); clicked => { root.go(12); } }
                    Text { text: @tr("Main" => "Services"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.svc-busy : Text { text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.svc-busy; clicked => { root.svc-rescan(); } }
                }
                Text {
                    text: @tr("Main" => "Background programs that systemd starts at boot. Changing one asks for your administrator password. The time is how long it took to start, which is not always how long the boot waited for it.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Status"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), @tr("Main" => "Enabled"), @tr("Main" => "Disabled")]; selected <=> root.svc-status-filter; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Kind"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), @tr("Main" => "Optional"), @tr("Main" => "Essential")]; selected <=> root.svc-rec-filter; }
                    }
                }
                // Second row: three labelled groups plus a search box do not fit on one line at the default width.
                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Activity"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), @tr("Main" => "Running"), @tr("Main" => "Stopped")]; selected <=> root.svc-run-filter; }
                    }
                    VerticalLayout { alignment: end; horizontal-stretch: 1; SearchBox { text <=> root.svc-query; placeholder: @tr("Main" => "Search"); typed: root.typed; seq: root.typed-seq; min-width: 60px; } }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        if root.services.length == 0 && !root.svc-busy : Text { text: @tr("Main" => "Nothing found."); color: Family.muted; }
                        for r in root.services : VerticalLayout {
                            if root.svc-shown(r) : ServiceItem {
                                item: r;
                                status-filter: root.svc-status-filter;
                                rec-filter: root.svc-rec-filter;
                                run-filter: root.svc-run-filter;
                                open: root.open-unit == r.unit;
                                toggle => { root.open-unit = root.open-unit == r.unit ? "" : r.unit; }
                                run => { root.svc-run(r.unit, !r.active); }
                                act => {
                                    if (r.enabled) {
                                        root.svc-precheck(r);
                                    } else {
                                        root.svc-pending = r;
                                        root.svc-hint = "";
                                        root.svc-note = "";
                                        root.svc-now = true;
                                        root.svc-confirming = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 2 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Back { text: @tr("Main" => "Speed"); clicked => { root.go(12); } }
                    Text { text: @tr("Main" => "Boot"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.boot-busy : Text { text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.boot-busy; clicked => { root.boot-rescan(); } }
                }
                if root.disk-warning : Rectangle {
                    background: Family.danger.with-alpha(0.15);
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;
                        Text {
                            text: @tr("Main" => "A mount failed or the kernel reported disk errors. Check the disk before making any mount automatic.");
                            wrap: word-wrap;
                            color: Palette.foreground;
                            vertical-alignment: center;
                        }
                        Button { text: @tr("Main" => "Disk health"); clicked => { root.go(7); } }
                    }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 14px;

                        Text { text: @tr("Main" => "Total: {} s", root.boot-total); font-size: Family.title; font-weight: Family.section-weight; color: Palette.foreground; }
                        HorizontalLayout {
                            height: 24px;
                            spacing: 2px;
                            for p in root.phases : Rectangle { horizontal-stretch: p.secs; background: Tr.phase-color(p.kind); }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            for p in root.phases : Text {
                                text: @tr("Main" => "{}: {} s", Tr.phase(p.kind), p.secs);
                                color: Tr.phase-color(p.kind);
                                font-size: Family.body;
                                font-weight: Family.section-weight;
                            }
                        }
                        Text {
                            text: @tr("Main" => "Firmware and the boot loader run before Linux starts; settings in your BIOS and the boot menu timeout affect them, nothing in the operating system does.");
                            wrap: word-wrap;
                            color: Family.muted;
                            font-size: Family.body;
                        }

                        Text { text: @tr("Main" => "What the desktop waited for"); font-size: Family.title; font-weight: Family.section-weight; color: Palette.foreground; }
                        Text {
                            text: @tr("Main" => "The critical chain: only these units delayed the desktop. The time on the Services page is how long a unit ran, which can be long without delaying anything.");
                            wrap: word-wrap;
                            color: Family.muted;
                            font-size: Family.body;
                        }
                        LearnMore {
                            label: @tr("Main" => "What are the boot phases?");
                            text: @tr("Main" => "A boot has four phases. Firmware (BIOS or UEFI) starts the hardware. The boot loader (GRUB) picks the system to start. The kernel starts Linux and the initrd finds your disk. Userspace then starts the services and the desktop.")
                                + "\n\n" + @tr("Main" => "The critical chain is the line of units that each had to wait for the one before it. Only those delay the desktop; other units start at the same time and cost nothing.");
                        }
                        if root.chain.length == 0 && !root.boot-busy : Text { text: @tr("Main" => "Nothing found."); color: Family.muted; }
                        for l in root.chain : HorizontalLayout {
                            spacing: 10px;
                            height: 28px;
                            Text { text: l.unit; width: 230px; overflow: elide; color: Palette.foreground; font-weight: l.slowest ? Family.section-weight : 400; vertical-alignment: center; }
                            Text { text: @tr("Main" => "at {} s", l.at); width: 80px; color: Family.muted; font-size: Family.body; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                Rectangle { x: 0px; width: parent.width * l.frac; height: 12px; background: l.slowest ? Family.danger : Family.info; }
                            }
                            Text { text: l.took > 0 ? @tr("Main" => "+ {} s", l.took) : ""; width: 64px; color: Palette.foreground; font-size: Family.body; horizontal-alignment: right; vertical-alignment: center; }
                            VerticalLayout {
                                alignment: center;
                                width: 150px;
                                if l.mount && l.took >= 2 && !root.disk-warning : Text {
                                    text: @tr("Main" => "Slow mount: x-systemd.automount in /etc/fstab mounts it on first use.");
                                    wrap: word-wrap;
                                    font-size: Family.caption;
                                    color: Family.muted;
                                }
                                if l.optional : Button {
                                    text: @tr("Main" => "See in Services");
                                    clicked => {
                                        // Reset the filters: the unit may be protected or disabled.
                                        root.svc-status-filter = 0;
                                        root.svc-rec-filter = 0;
                                        root.svc-run-filter = 0;
                                        root.svc-query = l.unit;
                                        root.open-unit = l.unit;
                                        root.page = 1;
                                    }
                                }
                            }
                        }

                        Text { text: @tr("Main" => "Boot menu"); font-size: Family.title; font-weight: Family.section-weight; color: Palette.foreground; }
                        Text {
                            text: @tr("Main" => "Boot loader: {}. Firmware: {}.", Tr.loader(root.grub.loader), root.grub.efi ? "UEFI" : "BIOS");
                            wrap: word-wrap;
                            color: Palette.foreground;
                        }
                        Text {
                            text: root.grub.timeout < 0 ? @tr("Main" => "GRUB_TIMEOUT is not set, so GRUB waits its default of 5 s.") : @tr("Main" => "GRUB_TIMEOUT is {} s.", root.grub.timeout);
                            wrap: word-wrap;
                            color: Palette.foreground;
                        }
                        if root.grub.style != "" : Text { text: @tr("Main" => "Menu style: {}. Hiding the menu also hides the recovery entries.", root.grub.style); wrap: word-wrap; color: Family.muted; }
                        if root.grub.windows : Text {
                            text: @tr("Main" => "Windows has its own UEFI boot entry, so a short GRUB timeout does not stop you from reaching it.");
                            wrap: word-wrap;
                            color: Family.muted;
                        }
                        if root.grub.overridden != "" : Text {
                            text: @tr("Main" => "Also set in {} (in /etc/default/grub.d). FastCheckup edits only /etc/default/grub, so a change here may have no effect.", root.grub.overridden);
                            wrap: word-wrap;
                            color: Family.warning;
                        }
                        if root.grub.loader != 0 : Text { text: @tr("Main" => "The timeout can only be changed here for GRUB."); wrap: word-wrap; color: Family.muted; }
                        if root.grub.loader == 0 && root.grub.timeout >= 0 && root.grub.timeout <= 1 : Empty { text: @tr("Main" => "Already 1 s or less. Nothing to change."); }
                        if root.grub.loader == 0 && (root.grub.timeout < 0 || root.grub.timeout > 1) : HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: @tr("Main" => "New timeout in seconds:"); color: Palette.foreground; vertical-alignment: center; }
                            timeout-edit := LineEdit { width: 80px; input-type: number; text: "1"; }
                            Button { text: @tr("Main" => "Set timeout"); clicked => { root.boot-preview(timeout-edit.text.to-float()); } }
                        }
                        if root.grub.has-backup : HorizontalLayout {
                            alignment: start;
                            Button { text: @tr("Main" => "Restore the last backup"); clicked => { root.boot-restore-preview(); } }
                        }

                        TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "BIOS / firmware checklist"); font-size: Family.title; font-weight: Family.section-weight; color: Palette.foreground; }
                        TextInput {
                            read-only: true;
                            selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                            text: @tr("Main" => "Linux cannot read these settings. Open your BIOS setup at power on and check them by hand. Board: {}", root.bios-board);
                            wrap: word-wrap;
                            color: Family.muted;
                            font-size: Family.body;
                        }
                        // One element so a single drag selects the whole list.
                        TextInput {
                            read-only: true;
                            selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                            wrap: word-wrap;
                            color: Palette.foreground;
                            text: "• " + @tr("Main" => "Fast Boot: on.")
                                + "\n• " + @tr("Main" => "Network / PXE boot ROM: off, if you never boot from the network.")
                                + "\n• " + @tr("Main" => "CSM / legacy boot: off on a UEFI install.")
                                + "\n• " + @tr("Main" => "Boot logo or full screen logo: off.")
                                + "\n• " + @tr("Main" => "Boot order: the disk with your system first.")
                                + "\n• " + @tr("Main" => "Unused SATA, USB or onboard controllers: off.");
                        }
                    }
                }
            }

            if root.page == 7 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Back { text: @tr("Main" => "Safety"); clicked => { root.go(11); } }
                    TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Disk health"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.health-busy : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    if root.health-ago >= 0 && !root.health-busy : Text { text: Tr.scanned-ago(root.health-ago); color: Family.muted; font-size: Family.body; vertical-alignment: center; }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.health-busy; clicked => { root.health-rescan(); } }
                }
                ScrollView {
                    content-y: root.scroll-bottom ? min(0px, self.height - self.content-height) : 0px;
                    VerticalLayout {
                        // Without this, a short page spreads its rows over the whole window.
                        alignment: start;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Tile { value: "\{root.disks.length}"; label: @tr("Main" => "disks"); }
                            Tile {
                                value: root.disk-warning ? @tr("Main" => "Problems") : @tr("Main" => "No errors");
                                label: @tr("Main" => "seen since this boot");
                                tone: root.disk-warning ? Family.danger : Family.success;
                            }
                        }
                        Text {
                            text: (root.disk-warning ? @tr("Main" => "Problems were found. If the data matters: back it up first, then check SMART, then repair or replace the disk. ddrescue can copy a failing disk; run it yourself, FastCheckup never does.")
                                : @tr("Main" => "No disk errors seen since this boot. That does not prove a disk is healthy; SMART below is a better sign."))
                                + " " + @tr("Main" => "Checking health asks for your administrator password and needs the smartmontools package.");
                            wrap: word-wrap;
                            color: Family.muted;
                            font-size: Family.body;
                        }
                        LearnMore {
                            label: @tr("Main" => "What is SMART?");
                            text: @tr("Main" => "SMART is a self-report that most disks keep about their own wear. It only reports; it repairs nothing.")
                                + "\n\n" + @tr("Main" => "Reallocated and pending sectors are places the disk could not read reliably. A few that never change are usually fine. A number that keeps growing means the disk is failing: back up first, then replace it.");
                        }
                        for d[i] in root.disks : Section {
                            property <int> level: root.disk-level(d);
                            // A click replaces this binding, so only the snapshot script sets it for every disk at once.
                            property <bool> show-parts: root.show-all-parts;
                            title: @tr("Main" => "{} ({}, {}, {})", d.model != "" ? d.model : d.name, d.size,
                                d.kind == 2 ? @tr("Main" => "NVMe SSD") : d.kind == 3 ? @tr("Main" => "USB drive") : d.kind == 1 ? @tr("Main" => "hard drive") : @tr("Main" => "SSD"), d.name);
                            badge: level == 0 ? @tr("Main" => "Not checked") : level == 1 ? @tr("Main" => "Healthy") : level == 2 ? @tr("Main" => "Warning") : @tr("Main" => "Failing");
                            badge-tone: level == 0 ? Family.muted : level == 1 ? Family.success : level == 2 ? Family.warning : Family.danger;
                            action: @tr("Main" => "Check health");
                            action-enabled: d.state != 4;
                            action-clicked => { root.smart-check(i, d.name); }
                            if d.problems != "" : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: d.problems; wrap: word-wrap; font-size: Family.body; color: Family.danger; }
                            if d.state == 4 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Working..."); color: Family.muted; }
                            if d.state == 3 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: d.error; wrap: word-wrap; color: Family.danger; }
                            // The badge already says Healthy, so only a warning or a failure gets a sentence.
                            if level > 1 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                                wrap: word-wrap;
                                color: level == 2 ? Family.warning : Family.danger;
                                text: level == 2 ? @tr("Main" => "Warning. The disk is showing early signs of wear or a bad cable. Back up your important files and check again in a few weeks.")
                                    : @tr("Main" => "Failing. Back up your files now and plan to replace this disk.");
                            }
                            if level > 0 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                                color: Palette.foreground.with-alpha(0.55);
                                font-size: Family.caption;
                                text: d.nvme ? @tr("Main" => "Details: worn {}%, spare {}%, media errors {}", d.used, d.spare, d.uncorrectable)
                                    : @tr("Main" => "Details: bad sectors moved {}, waiting {}, unreadable {}, cable errors {}", d.reallocated, d.pending, d.uncorrectable, d.crc);
                            }
                            // A quiet list under the disk; a card inside a card was too heavy.
                            if d.info != "" : Rectangle {
                                height: 22px;
                                Text {
                                    // An unset x centres a child of a plain Rectangle.
                                    x: 0px;
                                    text: show-parts ? @tr("Main" => "Hide partitions") : @tr("Main" => "Show partitions ({})", d.parts);
                                    color: Family.info;
                                    font-size: Family.body;
                                    horizontal-alignment: left;
                                    vertical-alignment: center;
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { show-parts = !show-parts; } }
                            }
                            if d.info != "" && show-parts : HorizontalLayout {
                                spacing: 8px;
                                Rectangle { width: 2px; background: Palette.foreground.with-alpha(0.25); }
                                TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: d.info; wrap: word-wrap; font-size: Family.body; color: Palette.foreground.with-alpha(0.75); horizontal-stretch: 1; }
                            }
                        }
                        if root.other-problems != "" : Section {
                            title: @tr("Main" => "Other disk problems");
                            TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.other-problems; wrap: word-wrap; font-size: Family.body; color: Family.danger; }
                        }
                        Section {
                            title: @tr("Main" => "Backup (Timeshift)");
                            TextInput {
                                read-only: true;
                                selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                                wrap: word-wrap;
                                font-size: Family.body;
                                color: root.backup-state == 2 ? Palette.foreground : Family.warning;
                                text: root.backup-state == 0 ? @tr("Main" => "Timeshift is not set up. Without a backup, a failing disk can take your system with it.")
                                    : root.backup-state == 1 ? @tr("Main" => "Timeshift is set up, but no snapshot was found. The backup disk may not be connected.")
                                    : @tr("Main" => "Newest Timeshift snapshot: {}", root.backup-latest);
                            }
                        }
                        Section {
                            title: @tr("Main" => "Unclean shutdowns");
                            TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.crashes; wrap: word-wrap; color: Palette.foreground; font-size: Family.body; }
                        }
                    }
                }
            }

            if root.page == 8 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Back { text: @tr("Main" => "Safety"); clicked => { root.go(11); } }
                    TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Security"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.security-busy : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    if root.security-ago >= 0 && !root.security-busy : Text { text: Tr.scanned-ago(root.security-ago); color: Family.muted; font-size: Family.body; vertical-alignment: center; }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.security-busy; clicked => { root.security-rescan(); } }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Tile { value: "\{root.sec-suspicious}"; label: @tr("Main" => "suspicious"); tone: root.sec-suspicious > 0 ? Family.danger : Palette.foreground; }
                            Tile { value: "\{root.sec-look}"; label: @tr("Main" => "worth a look"); tone: root.sec-look > 0 ? Family.warning : Palette.foreground; }
                            Tile { value: "\{root.sec-info}"; label: @tr("Main" => "information"); }
                        }
                        Text {
                            text: @tr("Main" => "Information only: nothing here is changed or removed. Without administrator rights some things stay hidden, so this can miss problems.");
                            wrap: word-wrap;
                            color: Family.muted;
                            font-size: Family.body;
                        }
                        if !root.security-busy && root.findings.length == 0 : Empty { text: @tr("Main" => "Nothing visible looks wrong. That is not a guarantee that the system is clean."); }
                        // Worst first (Rust sorts them). Each line is its own text, so it selects on its own.
                        // One box per topic; Network is always there because it also holds the firewall check.
                        for g in root.shown-groups : Section {
                            title: Tr.finding-group(g);
                            total: root.group-findings[g].length > 0 ? "\{root.group-findings[g].length}" : "";
                            if g == 0 && root.group-findings[0].length > 0 : Text {
                                text: @tr("Main" => "Anyone on your network can try to connect to the open ports listed here.");
                                wrap: word-wrap;
                                color: Family.muted;
                                font-size: Family.body;
                            }
                            if g == 0 : LearnMore {
                                label: @tr("Main" => "What is an open port?");
                                text: @tr("Main" => "A port is a numbered door that a program opens so others can talk to it. \"Listening\" means the program is waiting for a connection.")
                                    + "\n\n" + @tr("Main" => "127.0.0.1 can only be reached from this computer. 0.0.0.0 or :: can be reached from the network. Look closer when a program you do not know listens on 0.0.0.0, or when there is no firewall.");
                            }
                            if g == 0 && !root.fw-off : VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Main" => "Reading the rules asks for your administrator password and needs the ufw package. It only reads; nothing is changed.");
                                    wrap: word-wrap;
                                    color: Family.muted;
                                    font-size: Family.body;
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    Button { text: @tr("Main" => "Check firewall rules"); enabled: root.fw-state != 1; clicked => { root.firewall-check(); } }
                                }
                                if root.fw-state == 1 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Working..."); color: Family.muted; }
                                if root.fw-state == 2 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.fw-text; wrap: word-wrap; font-family: "DejaVu Sans Mono"; font-size: Family.body; color: Palette.foreground; }
                                if root.fw-state == 3 : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.fw-text; wrap: word-wrap; color: Family.danger; }
                            }
                            for f[i] in root.group-findings[g] : VerticalLayout {
                                spacing: 6px;
                                // Findings of one application are adjacent (Rust sorts them): the header shows where the application changes.
                                if f.app != "" && (i == 0 || root.group-findings[g][i - 1].app != f.app) : HorizontalLayout {
                                    spacing: 10px;
                                    AppIcon { source: f.icon; }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        Text { text: f.app; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                                        if f.path != "" : Text { text: f.path; color: Family.muted; font-size: Family.body; overflow: elide; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    // A wrapped TextInput in this nested layout reports one line of height, so long lines get room by hand.
                                    // shortcut: ~7px per character guess, not measured; replace if a font change breaks it.
                                    min-height: (Tr.row-line(f.code, f.subject, f.extra, f.n, f.app != "").character-count + (f.code == 8 ? f.subject.character-count : 0)) * 7px > root.width - (f.level == 2 ? 450px : 372px) ? 38px : 0px;
                                    // Rows of an application line up under its name, past the 32px icon.
                                    if f.app != "" : Rectangle { width: 32px; }
                                    if f.code == 8 : Text { text: f.subject; font-weight: Family.section-weight; color: Palette.foreground; vertical-alignment: top; }
                                    TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: Tr.row-line(f.code, f.subject, f.extra, f.n, f.app != ""); wrap: word-wrap; horizontal-stretch: 1; color: Palette.foreground; }
                                    // Only "Suspicious" gets a word: eleven "Worth a look" chips in a row were noise. The rest get
                                    // an icon, so the level never depends on colour alone: a triangle (worth a look) or an "i".
                                    VerticalLayout {
                                        alignment: start;
                                        padding-top: f.level == 2 ? 0px : 2px;
                                        width: f.level == 2 ? 90px : 16px;
                                        if f.level == 2 : Chip { text: @tr("Main" => "Suspicious"); tone: Family.danger; }
                                        if f.level != 2 : Icon {
                                            width: 16px;
                                            height: 16px;
                                            source: f.level == 1 ? @image-url("icons/triangle-alert.svg") : @image-url("icons/info.svg");
                                            tone: f.level == 1 ? Family.warning : Family.info;
                                            accessible-role: text;
                                            accessible-label: f.level == 1 ? @tr("Main" => "Worth a look") : @tr("Main" => "Info");
                                        }
                                    }
                                }
                                // No line between rows of one application: they read as one block.
                                if i < root.group-findings[g].length - 1 && (f.app == "" || root.group-findings[g][i + 1].app != f.app) : Rectangle { height: 1px; background: Palette.border; }
                            }
                        }
                        Section {
                            title: @tr("Main" => "Scanners you can run");
                            sub: @tr("Main" => "FastCheckup does not include these. Run them yourself in a terminal.");
                            collapsible: true;
                            for t in root.sec-tools : VerticalLayout {
                                spacing: 2px;
                                TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                                    text: t.installed ? @tr("Main" => "{} (installed)", t.name) : t.name;
                                    font-weight: Family.section-weight;
                                    color: Palette.foreground;
                                }
                                TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: t.cmd; wrap: word-wrap; font-size: Family.body; color: Family.muted; }
                            }
                        }
                    }
                }
            }

            if root.page == 3 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: @tr("Main" => "Apps"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.app-busy : Text { text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.app-busy; clicked => { root.app-rescan(); } }
                }
                Text {
                    text: @tr("Main" => "Programs installed from Debian packages, Flatpak and ~/AppImages. Removing one is always your choice, one at a time, and the size it frees is shown first.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                HorizontalLayout {
                    spacing: 24px;
                    // Both groups start with "All", so each is named.
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Source"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), "Debian", "Flatpak", "AppImage"]; selected <=> root.app-source-filter; }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        Text { text: @tr("Main" => "Kind"); color: Family.muted; font-size: Family.caption; }
                        FilterBar { labels: [@tr("Main" => "All"), @tr("Main" => "Optional"), @tr("Main" => "Essential")]; selected <=> root.app-rec-filter; }
                    }
                    VerticalLayout { alignment: end; horizontal-stretch: 1; SearchBox { text <=> root.app-query; placeholder: @tr("Main" => "Search"); typed: root.typed; seq: root.typed-seq; min-width: 60px; } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: @tr("Main" => "Sort by"); color: Family.muted; vertical-alignment: center; }
                    FilterBar {
                        labels: [@tr("Main" => "Size"), @tr("Main" => "Name"), @tr("Main" => "Date")];
                        icons: [root.sort-icon(0), root.sort-icon(1), root.sort-icon(2)];
                        tones: [Palette.foreground, Palette.foreground, Palette.foreground];
                        selected <=> root.app-sort;
                        flip <=> root.app-sort-flip;
                        toggle-again: true;
                        picked => { root.app-resort(); }
                    }
                    Rectangle { }
                }
                // Column captions: the same padding, spacing and widths as the head of `AppItem`.
                Rectangle {
                    height: 22px;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        Rectangle { width: 32px; }
                        Text { text: @tr("Main" => "Name"); color: Family.muted; font-size: Family.caption; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: @tr("Main" => "Size"); color: Family.muted; font-size: Family.caption; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                        Text { text: @tr("Main" => "Date"); color: Family.muted; font-size: Family.caption; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                        Text { text: @tr("Main" => "Source"); color: Family.muted; font-size: Family.caption; vertical-alignment: center; width: 80px; }
                        if root.app-rec-filter == 0 : Text { text: @tr("Main" => "Kind"); color: Family.muted; font-size: Family.caption; vertical-alignment: center; width: 96px; }
                        Rectangle { width: 14px; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        if root.apps.length == 0 && !root.app-busy : Text { text: @tr("Main" => "Nothing found."); color: Family.muted; }
                        for r in root.apps : VerticalLayout {
                            if root.app-shown(r) : AppItem {
                                item: r;
                                rec-filter: root.app-rec-filter;
                                open: root.open-app == r.id;
                                toggle => { root.open-app = root.open-app == r.id ? "" : r.id; }
                                act => { root.app-precheck(0, r.source, r.id, r.size-mb); }
                            }
                        }
                    }
                }
            }

            // Space: the disks, then every clean-up (Storage and Leftovers) by how safe it is. The Space dashboard and the
            // two pages it used to open are one page now.
            if root.page == 10 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: @tr("Main" => "Space"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.store-busy || root.app-busy : Text { text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    if root.store-ago >= 0 && !root.store-busy : Text { text: Tr.scanned-ago(root.store-ago); color: Family.muted; font-size: Family.body; vertical-alignment: center; }
                    if root.store-busy : Button { text: @tr("Main" => "Stop"); icon: @image-url("icons/stop.svg"); colorize-icon: true; clicked => { root.storage-stop(); } }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.store-busy && !root.app-busy; clicked => { root.storage-rescan(); root.app-rescan(); } }
                }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;

                        // On top so the space a clean-up frees shows right away.
                        // Not a `link` card: its touch area would cover the show-more toggle.
                        Section {
                            title: @tr("Main" => "Disks");
                            icon: @image-url("icons/hard-drive.svg");
                            if root.store-busy && root.mounts.length == 0 : Text { text: @tr("Main" => "Working..."); color: Family.muted; }
                            // Fullest first (sorted in main.rs); only the top three until asked. Spacing 0 and padded
                            // rows, so a hidden row leaves no gap.
                            VerticalLayout {
                                spacing: 0px;
                                for m[i] in root.mounts : VerticalLayout {
                                    if i < 3 || root.all-disks : VerticalLayout { padding-top: 3px; padding-bottom: 3px; MountRow { m: m; } }
                                }
                            }
                            if root.mounts.length > 3 : Rectangle {
                                height: 24px;
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 4px;
                                    Text {
                                        text: root.all-disks ? @tr("Main" => "Show fewer") : @tr("Main" => "Show {} more disks", root.mounts.length - 3);
                                        color: Family.info;
                                        font-size: Family.body;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout { alignment: center; Icon { source: root.all-disks ? @image-url("icons/chevron-up.svg") : @image-url("icons/chevron-down.svg"); tone: Family.info; width: 14px; height: 14px; } }
                                }
                                TouchArea { mouse-cursor: pointer; clicked => { root.all-disks = !root.all-disks; } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Tile { value: root.size(root.safe-free-mb); label: @tr("Main" => "safe to clean"); icon: Theme.tier-icon(0); icon-tone: Theme.tier-tone(0); tone: Theme.tier-tone(0); link: true; clicked => { root.store-group = 0; } }
                            Tile { value: root.size(root.almost-free-mb); label: @tr("Main" => "almost safe to clean"); icon: Theme.tier-icon(1); icon-tone: Theme.tier-tone(1); tone: Theme.tier-tone(1); link: true; clicked => { root.store-group = 1; } }
                            Tile { value: @tr("Main" => "{} MB", root.trash-mb); label: @tr("Main" => "in the Trash"); icon: @image-url("icons/trash.svg"); link: true; clicked => { root.store-group = 2; } }
                        }
                        Text {
                            text: @tr("Main" => "What takes space and what software left behind, sorted by how safe it is to remove. Safe and Almost safe can be cleaned together after you review the list and the commands; the rest is one item at a time. Your documents are never listed.");
                            wrap: word-wrap;
                            color: Family.muted;
                        }
                        HorizontalLayout {
                            alignment: start;
                            FilterBar {
                                labels: [@tr("Main" => "Safe"), @tr("Main" => "Almost safe"), @tr("Main" => "Must analyze"), @tr("Main" => "Look only")];
                                icons: [Theme.tier-icon(0), Theme.tier-icon(1), Theme.tier-icon(2), @image-url("icons/info.svg")];
                                tones: [Theme.tier-tone(0), Theme.tier-tone(1), Theme.tier-tone(2), Family.muted];
                                selected <=> root.store-group;
                            }
                        }

                        // One group at a time. A group is rebuilt when picked, so it always starts at the top.
                        if root.store-group == 0 : VerticalLayout {
                        spacing: 10px;
                        Section {
                            title: @tr("Main" => "Safe to remove");
                            tier: 0;
                            sub: @tr("Main" => "Caches, downloaded package files, old logs, Docker's build cache, unused Flatpak runtimes and packages nothing needs: the system or the app makes them again when needed, or nothing uses them any more. The review lists every package before anything runs.");
                            action: @tr("Main" => "Review and clean up..."); action-primary: true;
                            action-enabled: !root.store-busy && !root.app-busy;
                            action-clicked => { root.bulk-plan(0); }
                        }

                        Section {
                            title: @tr("Main" => "Caches");
                            tier: 0;
                            sub: @tr("Main" => "The biggest folders in ~/.cache. Apps fill them again, so the space comes back over time. Clearing is permanent.");
                            empty: root.caches.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.caches; calm: true; label: @tr("Main" => "Clear"); can-open: true; open(c) => { root.open-folder(1, c.id); } act(c) => { root.app-precheck(9, 0, c.id, c.size-mb); } }
                        }

                        Section {
                            title: @tr("Main" => "Downloaded package files");
                            tier: 0;
                            total: @tr("Main" => "{} MB", root.apt-mb);
                            sub: root.apt-mb > 1 ? @tr("Main" => "Copies of installed packages that APT keeps. Safe to remove; APT downloads them again if needed.") : "";
                            empty: root.apt-mb <= 1 ? @tr("Main" => "APT keeps {} MB of downloaded packages. Nothing to clean.", root.apt-mb) : "";
                            if root.apt-mb > 1 : HorizontalLayout {
                                alignment: start;
                                Button { text: @tr("Main" => "Clean"); enabled: !root.app-busy; clicked => { root.app-precheck(16, 0, "apt-cache", 0); } }
                            }
                        }

                        Section {
                            title: @tr("Main" => "System journal");
                            tier: 0;
                            total: @tr("Main" => "{} MB", root.journal-mb);
                            sub: root.journal-mb > 105 ? @tr("Main" => "The logs take {} MB. Older entries can be deleted, keeping the newest 100 MB.", root.journal-mb) : "";
                            empty: root.journal-mb <= 105 ? @tr("Main" => "The logs take {} MB. Nothing to shrink.", root.journal-mb) : "";
                            if root.journal-mb > 105 : HorizontalLayout {
                                alignment: start;
                                Button { text: @tr("Main" => "Keep 100 MB"); enabled: !root.app-busy; clicked => { root.app-precheck(10, 0, "journal", 0); } }
                            }
                        }

                        if root.docker.length != 0 : Section {
                            title: @tr("Main" => "Docker build cache");
                            tier: 0;
                            sub: @tr("Main" => "Docker rebuilds it on the next image build. Containers and images are in Must analyze.");
                            HorizontalLayout {
                                alignment: start;
                                Button { text: @tr("Main" => "Prune build cache"); enabled: !root.app-busy; clicked => { root.app-precheck(11, 0, "docker-builder", 0); } }
                            }
                        }

                        LearnMore {
                            label: @tr("Main" => "What are these?");
                            text: @tr("Main" => "Packages nothing needs (apt autoremove): packages that were installed only to support another program that is now gone.")
                                + "\n\n" + @tr("Main" => "Unused Flatpak runtimes: shared libraries that no installed Flatpak app needs any more. They are downloaded again if an app asks for them.");
                        }

                        Section {
                            title: @tr("Main" => "Unused Flatpak runtimes");
                            tier: 0;
                            total: root.rt-list == "" ? "" : @tr("Main" => "{} MB", root.rt-mb);
                            empty: root.rt-list == "" ? @tr("Main" => "Nothing to remove. Every Flatpak runtime is used by an installed app.") : "";
                            if root.rt-list != "" : Text { text: root.rt-list; wrap: word-wrap; color: Family.muted; font-size: Family.body; }
                            if root.rt-list != "" : HorizontalLayout {
                                alignment: start;
                                Button { text: @tr("Main" => "Remove ({} MB)", root.rt-mb); enabled: !root.app-busy; clicked => { root.app-precheck(2, 1, "flatpak-unused", 0); } }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Packages nothing needs (apt autoremove)");
                            tier: 0;
                            sub: root.auto-list == "" ? "" : @tr("Main" => "Read the list first: a package you use directly can be in it if it was only ever installed as a dependency.");
                            total: root.auto-list == "" ? "" : @tr("Main" => "{} MB", root.auto-mb);
                            empty: root.auto-list == "" ? @tr("Main" => "Nothing to remove.") : "";
                            if root.auto-list != "" : Text { text: root.auto-list; wrap: word-wrap; color: Family.muted; font-size: Family.body; }
                            if root.auto-list != "" : HorizontalLayout {
                                alignment: start;
                                Button { text: @tr("Main" => "Remove ({} MB)", root.auto-mb); enabled: !root.app-busy; clicked => { root.app-precheck(3, 0, "apt-autoremove", 0); } }
                            }
                        }
                        }

                        if root.store-group == 1 : VerticalLayout {
                        spacing: 10px;
                        Section {
                            title: @tr("Main" => "Almost safe");
                            tier: 1;
                            sub: @tr("Main" => "Build folders, installers and Trash entries older than {} days (change it in Preferences), and old tool versions (all but the newest 2). Most go to the Trash, so you can restore them; old Trash entries are deleted for good.", root.old-days);
                            action: @tr("Main" => "Review and clean up..."); action-primary: true;
                            action-enabled: !root.store-busy && !root.app-busy;
                            action-clicked => { root.bulk-plan(1); }
                        }

                        Section {
                            title: @tr("Main" => "Old build output (target, node_modules)");
                            tier: 1;
                            sub: @tr("Main" => "Found next to a Cargo.toml or package.json and not changed for {} days. They are moved to the Trash and rebuilt by the next build.", root.old-days);
                            empty: root.old-builds.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.old-builds; calm: true; label: @tr("Main" => "Move to Trash"); can-open: true; open(b) => { root.open-path(b.id); } act(b) => { root.app-precheck(6, 0, b.id, b.size-mb); } }
                        }

                        Section {
                            title: @tr("Main" => "Old installers in Downloads");
                            tier: 1;
                            sub: @tr("Main" => "Installers and archives over 20 MB that have not changed for {} days.", root.old-days);
                            empty: root.installers.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.installers; calm: true; label: @tr("Main" => "Move to Trash"); act(f) => { root.app-precheck(7, 0, f.id, f.size-mb); } }
                        }

                        Section {
                            title: @tr("Main" => "Old tool versions");
                            tier: 1;
                            sub: @tr("Main" => "Versions of a tool. The 2 newest and any Proton or Steam tool a game is set to use are kept; only the others can go to the Trash. Official Proton from Steam is removed in Steam (Library, Tools).");
                            empty: root.old-versions.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList {
                                items: root.old-versions;
                                can-open: true;
                                open(v) => { root.open-path(v.path); }
                                label: @tr("Main" => "Move to Trash");
                                act(v) => { root.app-precheck(13, 0, v.path, v.size-mb); }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Old Trash entries");
                            tier: 1;
                            sub: @tr("Main" => "Entries of your Trash deleted more than {} days ago. Only the Trash in your home folder is covered. They are deleted for good, so they are removed only by the review above, and only when emptying the Trash is allowed in Preferences.", root.old-days);
                            empty: root.old-trash.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.old-trash; deleted: true; }
                        }
                        }

                        if root.store-group == 2 : VerticalLayout {
                        spacing: 10px;
                        Section {
                            title: @tr("Main" => "Recent build output (target, node_modules)");
                            tier: 2;
                            sub: @tr("Main" => "Build folders changed in the last {} days: you may be working on them. They are moved to the Trash and rebuilt by the next build.", root.old-days);
                            empty: root.builds.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.builds; label: @tr("Main" => "Move to Trash"); can-open: true; open(b) => { root.open-path(b.id); } act(b) => { root.app-precheck(6, 0, b.id, b.size-mb); } }
                        }

                        Section {
                            title: @tr("Main" => "Duplicate files");
                            tier: 2;
                            collapsible: true;
                            sub: @tr("Main" => "Files of 1 MB or more with exactly the same content in your home. The oldest is kept as the original; a copy is checked byte by byte again before it goes to the Trash.");
                            HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button { text: @tr("Main" => "Find duplicates"); enabled: !root.dup-busy; clicked => { root.dup-find(); } }
                                if root.dup-busy : Button { text: @tr("Main" => "Stop"); icon: @image-url("icons/stop.svg"); colorize-icon: true; clicked => { root.storage-stop(); } }
                                if root.dup-busy : Text { text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                            }
                            if root.dup-scanned && !root.dup-busy && root.dups.length == 0 : Empty { text: @tr("Main" => "No duplicate files found."); }
                            StoreList {
                                items: root.dups;
                                label: @tr("Main" => "Move to Trash");
                                act(d) => { root.app-precheck(17, 0, d.id + "\n" + d.path, d.size-mb); }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Trash");
                            tier: 2;
                            total: root.trash-count == 0 ? "" : @tr("Main" => "{} MB", root.trash-mb);
                            sub: root.trash-count == 0 ? "" : @tr("Main" => "{} items, {} MB. Check them in your file manager first: emptying cannot be undone.", root.trash-count, root.trash-mb);
                            empty: root.trash-count == 0 ? @tr("Main" => "The Trash is empty.") : "";
                            if root.trash-count != 0 && root.allow-empty-trash : HorizontalLayout {
                                alignment: start;
                                Button { text: @tr("Main" => "Empty the Trash"); enabled: !root.app-busy; clicked => { root.app-precheck(8, 0, "trash", root.trash-mb); } }
                            }
                            if root.trash-count != 0 && !root.allow-empty-trash : Text {
                                text: @tr("Main" => "Emptying the Trash is off, so you can still restore what was cleaned. Turn it on in Preferences to enable it.");
                                wrap: word-wrap;
                                color: Family.muted;
                                font-size: Family.body;
                            }
                        }

                        if root.snap-set-up || root.snap-count > 0 : Section {
                            title: @tr("Main" => "System snapshots (Timeshift)");
                            tier: 2;
                            total: root.snap-count > 0 ? "\{root.snap-count}" : "";
                            Text {
                                text: root.snap-count > 0 ? @tr("Main" => "{} snapshots, the oldest from {}. They can take a lot of space; open Timeshift to see their size and delete old ones.", root.snap-count, root.snap-oldest) : @tr("Main" => "Timeshift is set up, but its snapshots could not be listed without administrator rights. Open Timeshift to see them.");
                                wrap: word-wrap;
                                color: Palette.foreground;
                                font-size: Family.body;
                            }
                        }

                        Section {
                            title: @tr("Main" => "Docker");
                            tier: 2;
                            if root.docker.length == 0 : Text { text: @tr("Main" => "Docker was not found, or you are not allowed to use it."); wrap: word-wrap; color: Family.muted; }
                            for d in root.docker : Text { text: @tr("Main" => "{}: {} in use, {} can be reclaimed", d.kind, d.size, d.reclaim); wrap: word-wrap; color: Palette.foreground; font-size: Family.body; }
                            if root.docker.length != 0 : HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Button { text: @tr("Main" => "Prune stopped containers and untagged images"); enabled: !root.app-busy; clicked => { root.app-precheck(12, 0, "docker-system", 0); } }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Settings of removed packages");
                            tier: 2;
                            sub: root.res-list == "" ? "" : @tr("Main" => "The program was removed but its configuration files stayed behind.");
                            total: root.res-list == "" ? "" : root.res-mb < 1 ? @tr("Main" => "{} KB", Math.round(root.res-mb * 1000)) : @tr("Main" => "{} MB", Math.round(root.res-mb * 10) / 10);
                            empty: root.res-list == "" ? @tr("Main" => "Nothing to remove.") : "";
                            if root.res-list != "" : Text { text: root.res-list; wrap: word-wrap; color: Family.muted; font-size: Family.body; }
                            if root.res-list != "" : HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: root.res-mb < 1 ? @tr("Main" => "Remove ({} KB)", Math.round(root.res-mb * 1000)) : @tr("Main" => "Remove ({} MB)", Math.round(root.res-mb * 10) / 10);
                                    enabled: !root.app-busy;
                                    clicked => { root.app-precheck(4, 0, "apt-purge-configs", 0); }
                                }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Old kernels");
                            tier: 2;
                            sub: @tr("Main" => "The kernel you are running and the newest one are always kept, so you can always boot. Only the others can be removed.");
                            for k in root.kernels : HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                height: 34px;
                                Text { text: k.version; color: Palette.foreground; font-weight: Family.section-weight; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: @tr("Main" => "{} MB", k.size-mb); width: 80px; color: Family.muted; font-size: Family.body; horizontal-alignment: right; vertical-alignment: center; }
                                if k.keep : VerticalLayout {
                                    alignment: center;
                                    width: 170px;
                                    Chip { text: k.running ? @tr("Main" => "Running now, kept") : @tr("Main" => "Newest or fallback, kept"); tone: Family.success; }
                                }
                                if !k.keep : VerticalLayout { alignment: center; width: 170px; Button { text: @tr("Main" => "Remove"); enabled: !root.app-busy; clicked => { root.app-precheck(5, 0, k.version, k.size-mb); } } }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Data of uninstalled Flatpaks");
                            tier: 2;
                            empty: root.leftovers.length == 0 ? @tr("Main" => "Nothing to remove.") : "";
                            for l in root.leftovers : LeftItem {
                                item: l;
                                act => { root.app-precheck(1, 1, l.id, l.size-mb); }
                                open => { root.open-folder(0, l.id); }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Settings of apps that look uninstalled");
                            tier: 2;
                            collapsible: root.home-data.length != 0;
                            empty: root.home-data.length == 0 ? @tr("Main" => "Nothing to remove.") : "";
                            Text {
                                text: @tr("Main" => "Risky: this is only a guess from the folder name, so some of these still belong to an app you use (a plug-in, an app with another name, a portable program). Open the folder and check before you remove one. Removing a used one loses its settings and logins until you restore it from the Trash.");
                                wrap: word-wrap;
                                color: Family.warning;
                                font-size: Family.body;
                            }
                            for h in root.home-data : LeftItem {
                                item: h;
                                act => { root.app-precheck(15, 1, h.id, h.size-mb); }
                                open => { root.open-path(h.path); }
                            }
                        }

                        Section {
                            title: @tr("Main" => "Startup entries of uninstalled apps");
                            tier: 2;
                            empty: root.stale-startup.length == 0 ? @tr("Main" => "Nothing to remove.") : "";
                            for s in root.stale-startup : HorizontalLayout {
                                height: 54px;
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: s.used; color: Palette.foreground; font-weight: Family.section-weight; overflow: elide; }
                                    TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "The program is not installed: {}", s.path); color: Family.muted; font-size: Family.body; }
                                }
                                VerticalLayout { alignment: center; IconButton { source: @image-url("icons/folder.svg"); label: @tr("Main" => "Open folder"); clicked => { root.open-autostart(s.id); } } }
                                VerticalLayout { alignment: center; Button { text: @tr("Main" => "Move to Trash"); enabled: !root.app-busy; clicked => { root.app-precheck(14, 1, s.id, 0); } } }
                            }
                        }
                        }

                        if root.store-group == 3 : VerticalLayout {
                        spacing: 10px;
                        Section {
                            title: @tr("Main" => "Biggest folders in your home");
                            sub: @tr("Main" => "Only for information: your own files are never offered for removal. Open a folder to look inside.");
                            collapsible: root.top-folders.length != 0;
                            open: true;
                            empty: root.top-folders.length == 0 && !root.store-busy ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.top-folders; can-open: true; open(f) => { root.open-folder(2, f.id); } }
                        }

                        Section {
                            title: @tr("Main" => "Biggest files in your home");
                            sub: @tr("Main" => "Files of 100 MB or more, biggest first. Only for information.");
                            collapsible: root.big-files.length != 0;
                            empty: root.big-files.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.big-files; can-open: true; open(f) => { root.open-path(f.path); } }
                        }

                        Section {
                            title: @tr("Main" => "Game libraries");
                            sub: @tr("Main" => "Steam (all libraries), Heroic and Bottles. Only for information: uninstall a game from its launcher.");
                            empty: root.games.length == 0 ? @tr("Main" => "Nothing found.") : "";
                            StoreList { items: root.games; can-open: true; open(g) => { root.open-path(g.path); } }
                        }
                        }
                    }
                }
            }

            if root.page == 9 : VerticalLayout {
                spacing: 12px;
                Text { text: @tr("Main" => "Overview"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        if root.sandboxed : Text { text: @tr("Main" => "Cannot reach the host: only this sandbox is inspected, so the results below are not your system."); wrap: word-wrap; color: Family.warning; font-size: Family.body; font-weight: Family.section-weight; }
                        if !root.is-root && !root.sandboxed && !root.admin-hidden && root.admin-state != 2 : Section {
                            title: @tr("Main" => "Admin checks");
                            icon: @image-url("icons/lock.svg");
                            sub: @tr("Main" => "Without the administrator password some checks see less: programs and ports of other users, firewall rules, disk health and Timeshift snapshots. One password prompt runs them all; the app stays under your account.");
                            action: root.admin-state == 1 ? @tr("Main" => "Working...") : @tr("Main" => "Run admin checks");
                            action-enabled: root.admin-state != 1;
                            action-primary: true;
                            action-clicked => { root.admin-run(); }
                            action2: @tr("Main" => "Hide");
                            action2-clicked => { root.admin-hidden = true; }
                            if root.admin-state == 3 : Text { text: root.admin-error; wrap: word-wrap; color: Family.danger; font-size: Family.body; }
                        }
                        if !root.store-scanned || !root.health-scanned || !root.security-scanned : Text { text: @tr("Main" => "Space and Safety are checked the first time you open them."); wrap: word-wrap; color: Family.muted; font-size: Family.body; }
                        // Four cards of the same size, two per line. Placed by hand: stretch factors leave cards uneven
                        // when their content differs, and min/max-width from parent.width is a binding loop in a ScrollView.
                        Rectangle {
                            height: 92px;
                            Rectangle {
                                x: 0px;
                                width: (parent.width - 10px) / 2;
                                height: 92px;
                            Section {
                                width: parent.width;
                                height: parent.height;
                                link: true;
                                clicked => { root.go(7); }
                                title: @tr("Main" => "Disk health");
                                icon: @image-url("icons/activity.svg");
                                status: true;
                                dot: Theme.level-color(root.health-level);
                                Text { text: root.disk-warning ? @tr("Main" => "Disk errors") : !root.health-scanned ? @tr("Main" => "Not checked yet") : @tr("Main" => "No disk errors seen"); font-size: 18px; font-weight: Family.section-weight; color: root.disk-warning ? Family.danger : !root.health-scanned ? Theme.muted : Palette.foreground; wrap: word-wrap; }
                                Text { text: root.disk-warning ? @tr("Main" => "Disk errors were seen since this boot.") : ""; color: Family.muted; font-size: Family.body; }
                            }
                            }
                            Rectangle {
                                x: (parent.width + 10px) / 2;
                                width: (parent.width - 10px) / 2;
                                height: 92px;
                            Section {
                                width: parent.width;
                                height: parent.height;
                                link: true;
                                clicked => { root.go(10); }
                                title: @tr("Main" => "Space");
                                icon: @image-url("icons/hard-drive.svg");
                                status: true;
                                dot: Theme.level-color(root.space-level);
                                Text { text: root.store-scanned ? @tr("Main" => "{} can be freed", root.size(root.safe-free-mb + root.almost-free-mb)) : @tr("Main" => "Not checked yet"); font-size: 18px; font-weight: Family.section-weight; color: root.store-scanned ? Palette.foreground : Theme.muted; wrap: word-wrap; }
                                Text { text: root.store-scanned ? @tr("Main" => "Fullest disk: {}%", root.fullest-pct) : ""; color: Family.muted; font-size: Family.body; }
                            }
                            }
                        }
                        Rectangle {
                            height: 92px;
                            Rectangle {
                                x: 0px;
                                width: (parent.width - 10px) / 2;
                                height: 92px;
                            Section {
                                width: parent.width;
                                height: parent.height;
                                link: true;
                                clicked => { root.go(11); }
                                title: @tr("Main" => "Safety");
                                icon: @image-url("icons/shield.svg");
                                status: true;
                                dot: Theme.level-color(root.security-level);
                                Text { text: root.security-scanned ? @tr("Main" => "{} suspicious", root.sec-suspicious) : @tr("Main" => "Not checked yet"); font-size: 18px; font-weight: Family.section-weight; color: !root.security-scanned ? Theme.muted : root.sec-suspicious > 0 ? Family.danger : Palette.foreground; wrap: word-wrap; }
                                Text { text: root.security-scanned ? @tr("Main" => "{} worth a look", root.sec-look) : ""; color: Family.muted; font-size: Family.body; }
                            }
                            }
                            Rectangle {
                                x: (parent.width + 10px) / 2;
                                width: (parent.width - 10px) / 2;
                                height: 92px;
                            Section {
                                width: parent.width;
                                height: parent.height;
                                link: true;
                                clicked => { root.go(12); }
                                title: @tr("Main" => "Speed");
                                icon: @image-url("icons/gauge.svg");
                                status: true;
                                // The boot time is read when the scan finishes; 0 means it has not been.
                                dot: Theme.level-color(root.speed-level);
                                Text { text: root.boot-total > 0 ? @tr("Main" => "{} s", root.boot-total) : "–"; font-size: 18px; font-weight: Family.section-weight; color: root.boot-total > 0 ? Palette.foreground : Theme.muted; wrap: word-wrap; }
                                Text { text: @tr("Main" => "last boot"); color: Family.muted; font-size: Family.body; }
                            }
                            }
                        }
                        // Below the cards, which are fixed navigation: this one changes height once it is sampled.
                        Section {
                            title: @tr("Main" => "Right now");
                            icon: @image-url("icons/activity.svg");
                            badge: root.perf-busy || root.perf-level == 0 ? "" : root.perf-level == 1 ? @tr("Main" => "Fine") : root.perf-level == 2 ? @tr("Main" => "Worth a look") : @tr("Main" => "Problem");
                            badge-tone: Theme.level-color(root.perf-level);
                            action: @tr("Main" => "Refresh");
                            action-enabled: !root.perf-busy;
                            action-clicked => { root.perf-rescan(); }
                            Text {
                                text: root.perf-busy ? @tr("Main" => "Measuring…") : root.perf-level == 0 ? "" : root.perf-cause == 1 ? @tr("Main" => "Short of memory.") : root.perf-cause == 2 ? @tr("Main" => "The processor is busy.") : root.perf-cause == 3 ? @tr("Main" => "The disk is slow to respond.") : @tr("Main" => "Running smoothly.");
                                font-size: Family.title;
                                wrap: word-wrap;
                                color: root.perf-busy || root.perf-level == 0 ? Theme.muted : Palette.foreground;
                            }
                            if root.perf-level > 0 : VerticalLayout {
                                spacing: 6px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    Tile {
                                        value: root.perf-mem-total-mb > 0 ? @tr("Main" => "{}%", Math.round(100 * (root.perf-mem-total-mb - root.perf-mem-avail-mb) / root.perf-mem-total-mb)) : "–";
                                        label: @tr("Main" => "memory, {} of {} used", root.size(root.perf-mem-total-mb - root.perf-mem-avail-mb), root.size(root.perf-mem-total-mb));
                                    }
                                    if root.perf-swap-total-mb > 0 : Tile {
                                        value: @tr("Main" => "{}%", Math.round(100 * root.perf-swap-used-mb / root.perf-swap-total-mb));
                                        label: @tr("Main" => "swap, {} of {} used", root.size(root.perf-swap-used-mb), root.size(root.perf-swap-total-mb));
                                    }
                                    Tile {
                                        value: "\{Math.round(root.perf-load * 10) / 10}";
                                        label: @tr("Main" => "load, {} cores", root.perf-cpus);
                                    }
                                }
                                if root.perf-apps.length == 0 : Text { text: @tr("Main" => "Nothing is using much right now."); color: Family.muted; wrap: word-wrap; }
                                // A table: name, CPU share (with a bar) and memory, numbers right-aligned so they compare.
                                for a in root.perf-apps : VerticalLayout {
                                    Rectangle { height: 1px; background: Palette.border; }
                                    HorizontalLayout {
                                        height: 30px;
                                        spacing: 12px;
                                        Text { text: a.procs > 1 ? "\{a.name} ×\{a.procs}" : a.name; color: Palette.foreground; font-size: Family.body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                        VerticalLayout { alignment: center; width: 90px; Bar { frac: a.cpu / 100; tone: Family.info; height: 6px; } }
                                        Text { text: @tr("Main" => "{}%", Math.round(a.cpu)); width: 44px; color: Palette.foreground; font-size: Family.body; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: root.size(a.mem-mb); width: 72px; color: Family.muted; font-size: Family.body; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    if root.perf-apps.length != 0 : Text { text: @tr("Main" => "CPU is a share of the whole computer, not of one core."); color: Family.muted; font-size: Family.body; wrap: word-wrap; horizontal-stretch: 1; }
                                    Text {
                                        text: root.perf-uptime-s < 3600 ? @tr("Main" => "Up {} min", Math.floor(root.perf-uptime-s / 60)) : root.perf-uptime-s < 86400 ? @tr("Main" => "Up {} h", Math.floor(root.perf-uptime-s / 3600)) : @tr("Main" => "Up {} d", Math.floor(root.perf-uptime-s / 86400));
                                        color: Family.muted;
                                        font-size: Family.body;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 11 : VerticalLayout {
                spacing: 12px;
                Text { text: @tr("Main" => "Safety"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Tile { value: "\{root.sec-suspicious}"; label: @tr("Main" => "suspicious"); icon: @image-url("icons/lock.svg"); tone: root.sec-suspicious > 0 ? Family.danger : Palette.foreground; link: true; clicked => { root.go(8); } }
                            Tile { value: "\{root.sec-look}"; label: @tr("Main" => "worth a look"); icon: @image-url("icons/lock.svg"); tone: root.sec-look > 0 ? Family.warning : Palette.foreground; link: true; clicked => { root.go(8); } }
                            Tile {
                                link: true;
                                clicked => { root.go(7); }
                                icon: @image-url("icons/activity.svg");
                                value: root.disk-warning ? @tr("Main" => "Problems") : @tr("Main" => "No errors");
                                label: @tr("Main" => "seen since this boot");
                                tone: root.disk-warning ? Family.danger : Family.success;
                            }
                        }
                        Section {
                            link: true;
                            clicked => { root.go(7); }
                            title: @tr("Main" => "Disk health");
                            icon: @image-url("icons/activity.svg");
                            if root.health-busy && root.disks.length == 0 : Text { text: @tr("Main" => "Working..."); color: Family.muted; }
                            for d in root.disks : HorizontalLayout {
                                spacing: 10px;
                                height: 26px;
                                Text { text: d.model != "" ? d.model : d.name; color: Palette.foreground; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                VerticalLayout {
                                    alignment: center;
                                    Chip {
                                        text: root.disk-level(d) == 0 ? @tr("Main" => "Not checked") : root.disk-level(d) == 1 ? @tr("Main" => "Healthy") : root.disk-level(d) == 2 ? @tr("Main" => "Warning") : @tr("Main" => "Failing");
                                        tone: root.disk-level(d) == 0 ? Family.muted : root.disk-level(d) == 1 ? Family.success : root.disk-level(d) == 2 ? Family.warning : Family.danger;
                                    }
                                }
                            }
                        }
                        Section {
                            link: true;
                            clicked => { root.go(8); }
                            title: @tr("Main" => "Security");
                            icon: @image-url("icons/lock.svg");
                            sub: @tr("Main" => "Worst first.");
                            total: "\{root.findings.length}";
                            if root.security-busy && root.findings.length == 0 : Text { text: @tr("Main" => "Working..."); color: Family.muted; }
                            if !root.security-busy && root.findings.length == 0 : Empty { text: @tr("Main" => "Nothing visible looks wrong. That is not a guarantee that the system is clean."); }
                            for f in root.top-findings : HorizontalLayout {
                                spacing: 10px;
                                height: 24px;
                                VerticalLayout {
                                    alignment: center;
                                    width: 90px;
                                    Chip {
                                        text: f.level == 2 ? @tr("Main" => "Suspicious") : f.level == 1 ? @tr("Main" => "Worth a look") : @tr("Main" => "Info");
                                        tone: f.level == 2 ? Family.danger : f.level == 1 ? Family.warning : Family.info;
                                    }
                                }
                                Text { text: Tr.finding-line(f.code, f.subject, f.extra, f.n); color: Palette.foreground; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            }
                        }
                    }
                }
            }

            if root.page == 12 : VerticalLayout {
                spacing: 12px;
                Text { text: @tr("Main" => "Speed"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 10px;
                            Tile { value: @tr("Main" => "{} s", root.boot-total); label: @tr("Main" => "last boot"); icon: @image-url("icons/timer.svg"); link: true; clicked => { root.go(2); } }
                            Tile { value: "\{root.rows.length}"; label: @tr("Main" => "startup entries"); icon: @image-url("icons/power.svg"); link: true; clicked => { root.go(0); } }
                            Tile { value: "\{root.services.length}"; label: @tr("Main" => "services"); icon: @image-url("icons/server.svg"); link: true; clicked => { root.go(1); } }
                        }
                        Section {
                            link: true;
                            clicked => { root.go(2); }
                            title: @tr("Main" => "Where the boot time goes");
                            icon: @image-url("icons/timer.svg");
                            HorizontalLayout {
                                height: 14px;
                                spacing: 2px;
                                for p in root.phases : Rectangle { horizontal-stretch: p.secs; background: Tr.phase-color(p.kind); border-radius: 3px; }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                alignment: start;
                                for p in root.phases : Text {
                                    text: @tr("Main" => "{}: {} s", Tr.phase(p.kind), p.secs);
                                    color: Tr.phase-color(p.kind);
                                    font-size: Family.body;
                                }
                            }
                        }
                        // Read by the Disk health scan (go() runs it for this page too).
                        Section {
                            title: @tr("Main" => "Memory safety net");
                            icon: @image-url("icons/gauge.svg");
                            if root.health-busy && root.mem-text == "" : Text { text: @tr("Main" => "Working..."); color: Family.muted; }
                            TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.mem-text; wrap: word-wrap; font-size: Family.body; color: root.mem-warning ? Family.warning : Palette.foreground; }
                            LearnMore {
                                label: @tr("Main" => "Swap and zram: what they are");
                                open <=> root.mem-info-open;
                                text: @tr("Main" => "Swap is space the computer uses when memory is full: it moves pages that are not in use out of memory so the rest keeps running. With none, a spike in memory use can freeze the whole desktop until a program is killed.")
                                    + "\n\n" + @tr("Main" => "Traditional swap (a file or partition on the disk) is large and cheap, and is needed to hibernate. But the disk is much slower than memory, so a computer that leans on it feels slow, and it adds writes to an SSD.")
                                    + "\n\n" + @tr("Main" => "zram swap lives in memory and keeps the pages compressed, usually 2 to 3 times smaller. It is fast, uses no disk and wears nothing, but it takes real memory and cannot be used to hibernate. It suits computers with 8 GB or more that only need a buffer for spikes.")
                                    + "\n\n" + @tr("Main" => "You can use both: zram first, with a small disk swap behind it for hibernation or very large loads. Neither fixes a program that never stops growing; that is what a low-memory watcher (earlyoom) is for.");
                            }
                        }
                    }
                }
            }

            if root.page == 13 : VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "System"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; vertical-alignment: center; }
                    if root.sys-busy : TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: @tr("Main" => "Working..."); color: Family.muted; vertical-alignment: center; }
                    Rectangle { }
                    Button { text: @tr("Main" => "Copy all"); enabled: !root.sys-busy; clicked => { copy-box.select-all(); copy-box.copy(); } }
                    Button { text: @tr("Main" => "Scan again"); icon: @image-url("icons/refresh.svg"); colorize-icon: true; enabled: !root.sys-busy; clicked => { root.sys-rescan(); } }
                }
                ScrollView {
                    content-y: root.scroll-bottom ? min(0px, self.height - self.content-height) : 0px;
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        for g in root.sys-groups : Section {
                            title: g.title;
                            // Faint zebra stripes so the eye can follow a label across to its value.
                            for r[i] in g.rows : Rectangle {
                                height: row-inner.preferred-height;
                                border-radius: 4px;
                                background: Math.mod(i, 2) == 0 ? Palette.foreground.with-alpha(0.04) : transparent;
                                row-inner := VerticalLayout {
                                    padding: 3px;
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    InfoLine { label: r.label; value: r.value; }
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 5 : VerticalLayout {
                spacing: 12px;
                Text { text: @tr("Main" => "History"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; }
                if root.history.length == 0 : Text { text: @tr("Main" => "Nothing has been changed yet."); color: Family.muted; }
                ScrollView {
                    VerticalLayout {
                        // Without this, few rows stretch to fill the window.
                        alignment: start;
                        spacing: 6px;
                        // One text for the whole log, so it selects and copies in one go.
                        TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.history-text; wrap: word-wrap; color: Palette.foreground; font-size: Family.body; }
                    }
                }
            }
        }
        }
    }

    // Confirm dialog: shows exactly what will be written before anything changes.
    if root.confirming : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, 520px);
            height: dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            dialog := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: root.pending.state == 0 ? @tr("Main" => "Disable at startup: {}", root.pending.name) : @tr("Main" => "Enable at startup: {}", root.pending.name);
                    font-size: Family.title;
                    font-weight: Family.section-weight;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                TextInput {
                    read-only: true;
                    selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                    text: root.pending.state == 0 ? @tr("Main" => "Writes this file with X-GNOME-Autostart-enabled=false: {}", root.pending.target) : @tr("Main" => "Removes X-GNOME-Autostart-enabled=false from {}. If it then matches the system file, it is deleted.", root.pending.target);
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                Text { text: @tr("Main" => "Runs as your user. No password needed."); wrap: word-wrap; color: Family.muted; }
                Text {
                    text: root.pending.state == 0 ? @tr("Main" => "Undo: press Enable on this row.") : @tr("Main" => "Undo: press Disable at startup on this row.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Main" => "Cancel"); clicked => { root.confirming = false; } }
                    Button {
                        text: root.pending.state == 0 ? @tr("Main" => "Disable") : @tr("Main" => "Enable");
                        primary: true;
                        clicked => {
                            root.confirming = false;
                            root.apply(root.pending.file, root.pending.name, root.pending.state);
                        }
                    }
                }
            }
        }
    }

    // Confirm dialog for a service: shows the exact command that will run as root.
    if root.svc-confirming : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, 520px);
            height: svc-dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            svc-dialog := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: root.svc-pending.enabled ? @tr("Main" => "Disable service: {}", root.svc-pending.unit) : @tr("Main" => "Enable service: {}", root.svc-pending.unit);
                    font-size: Family.title;
                    font-weight: Family.section-weight;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                TextInput {
                    read-only: true;
                    selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground;
                    text: "pkexec systemctl " + (root.svc-pending.enabled ? "disable" : "enable") + (root.svc-now ? " --now " : " ") + root.svc-pending.unit;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                Text { text: @tr("Main" => "Needs your administrator password."); wrap: word-wrap; color: Family.muted; }
                if root.svc-note != "" : Text { text: root.svc-note; wrap: word-wrap; color: Family.warning; }
                if root.svc-hint != "" : Text { text: root.svc-hint; wrap: word-wrap; color: Palette.foreground; }
                Text {
                    text: root.svc-pending.enabled ? @tr("Main" => "Undo: press Enable on this row.") : @tr("Main" => "Undo: press Disable on this row.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Main" => "Cancel"); clicked => { root.svc-confirming = false; } }
                    Button {
                        text: !root.svc-pending.enabled ? @tr("Main" => "Enable") : root.svc-now ? @tr("Main" => "Disable") : @tr("Main" => "Disable only");
                        primary: true;
                        clicked => {
                            root.svc-confirming = false;
                            root.svc-apply(root.svc-pending.unit, !root.svc-pending.enabled, root.svc-now);
                        }
                    }
                }
            }
        }
    }

    // Confirm dialog for an app: the exact command and the size that will be freed.
    if root.app-confirming : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, 520px);
            height: app-dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            app-dialog := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: root.app-action == 0 ? (root.app-source == 2 ? @tr("Main" => "Move to the Trash: {}", root.app-id) : @tr("Main" => "Uninstall: {}", root.app-id))
                        : root.app-action == 1 ? @tr("Main" => "Move the leftover data of {} to the Trash", root.app-id)
                        : root.app-action == 2 ? @tr("Main" => "Remove unused Flatpak runtimes")
                        : root.app-action == 3 ? @tr("Main" => "Remove packages nothing needs")
                        : root.app-action == 5 ? @tr("Main" => "Remove kernel {}", root.app-id)
                        : root.app-action == 6 || root.app-action == 7 || root.app-action == 13 || root.app-action == 14 || root.app-action == 15 ? @tr("Main" => "Move to the Trash: {}", root.app-id)
                        : root.app-action == 8 ? @tr("Main" => "Empty the Trash")
                        : root.app-action == 9 ? @tr("Main" => "Clear the cache of {}", root.app-id)
                        : root.app-action == 10 ? @tr("Main" => "Shrink the system journal")
                        : root.app-action == 11 ? @tr("Main" => "Prune the Docker build cache")
                        : root.app-action == 12 ? @tr("Main" => "Prune Docker stopped containers and untagged images")
                        : root.app-action == 16 ? @tr("Main" => "Delete downloaded package files")
                        : root.app-action == 17 ? @tr("Main" => "Move the duplicate to the Trash")
                        : @tr("Main" => "Delete the settings of removed packages");
                    font-size: Family.title;
                    font-weight: Family.section-weight;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.app-cmd; wrap: word-wrap; font-size: Family.body; color: Palette.foreground; }
                if root.app-action != 12 && root.app-action != 14 : Text { text: root.app-freed < 1 ? @tr("Main" => "Frees about {} KB.", Math.round(root.app-freed * 1000)) : @tr("Main" => "Frees about {} MB.", Math.round(root.app-freed * 10) / 10); wrap: word-wrap; color: Palette.foreground; font-weight: Family.section-weight; }
                if (root.app-action == 0 && root.app-source == 0) || (root.app-action >= 3 && root.app-action < 6) || root.app-action == 10 : Text { text: @tr("Main" => "Needs your administrator password."); wrap: word-wrap; color: Family.muted; }
                if root.app-note != "" : Text { text: root.app-note; wrap: word-wrap; color: Family.warning; }
                Text {
                    text: root.app-action == 0 && root.app-source != 2 ? @tr("Main" => "Your settings in your home folder are kept. Install it again to undo.")
                        : root.app-action == 2 ? @tr("Main" => "Runtimes are downloaded again when an app needs them.")
                        : root.app-action == 3 ? @tr("Main" => "Install a package again to undo. Packages you install by hand are never listed here.")
                        : root.app-action == 5 ? @tr("Main" => "Install the kernel package again to undo. The boot menu is updated by apt.")
                        : root.app-action == 4 ? @tr("Main" => "These files in /etc cannot be restored. The packages are already gone.")
                        : root.app-action == 8 ? @tr("Main" => "This cannot be undone.")
                        : root.app-action == 9 ? @tr("Main" => "This cannot be undone. The app rebuilds its cache when it needs it.")
                        : root.app-action == 10 ? @tr("Main" => "Deleted log entries cannot be restored.")
                        : root.app-action == 11 ? @tr("Main" => "Docker rebuilds the cache on the next image build. This cannot be undone.")
                        : root.app-action == 12 ? @tr("Main" => "Volumes and images that have a tag are kept. Stopped containers are deleted, which cannot be undone.")
                        : root.app-action == 15 ? @tr("Main" => "Only a guess that the app is gone. If you still use it, you lose its settings and logins until you restore the folder from the Trash.")
                        : @tr("Main" => "Undo: restore it from the Trash.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Main" => "Cancel"); clicked => { root.app-confirming = false; } }
                    Button {
                        text: root.app-action == 0 && root.app-source != 2 ? @tr("Main" => "Uninstall") : @tr("Main" => "Remove");
                        primary: true;
                        clicked => {
                            root.app-confirming = false;
                            root.app-apply(root.app-action, root.app-source, root.app-id);
                        }
                    }
                }
            }
        }
    }

    // Bulk clean-up of a tier: every item with a tick, the total, and the exact command lines on request. Nothing runs
    // before "Clean up". Lists are capped by the window height (from `root`, not the parent, so no binding loop).
    if root.bulk-confirming : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, 600px);
            height: bulk-dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            bulk-dialog := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; Icon { source: Theme.tier-icon(root.bulk-tier); tone: Theme.tier-tone(root.bulk-tier); width: 18px; height: 18px; } }
                    Text {
                        text: root.bulk-tier == 0 ? @tr("Main" => "Clean up what is safe") : @tr("Main" => "Clean up what is almost safe");
                        font-size: Family.title;
                        font-weight: Family.section-weight;
                        wrap: word-wrap;
                        color: Palette.foreground;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: root.bulk-tier == 0
                        ? @tr("Main" => "Caches, package files and logs are deleted for good; they come back when needed. Untick what you want to keep.")
                        : @tr("Main" => "Build folders, installers and Trash entries older than {} days, and old tool versions (all but the newest 2). Build folders, installers and tool versions go to the Trash, so you can restore them. Old Trash entries are deleted for good. Untick what you want to keep.", root.old-days);
                    wrap: word-wrap;
                    color: Family.muted;
                    font-size: Family.body;
                }
                if root.bulk.length == 0 : Empty { text: @tr("Main" => "Nothing to clean up here."); }
                ScrollView {
                    height: Math.min(root.height * 0.2, root.bulk.length * 32px);
                    VerticalLayout {
                        for r[i] in root.bulk : HorizontalLayout {
                            height: 32px;
                            spacing: 10px;
                            CheckBox { text: root.bulk-label(r.action, r.name); checked: r.on; toggled => { root.bulk-toggle(i); } horizontal-stretch: 1; min-width: 0px; }
                            Text { text: @tr("Main" => "{} MB", r.size-mb); width: 80px; color: Family.muted; font-size: Family.body; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }
                }
                Text {
                    text: @tr("Main" => "Frees about {} MB ({} items).", Math.round(root.bulk-mb * 10) / 10, root.bulk-count);
                    wrap: word-wrap;
                    color: Palette.foreground;
                    font-weight: Family.section-weight;
                }
                if root.bulk-detail != "" : ScrollView {
                    height: Math.min(root.height * 0.12, detail-box.preferred-height);
                    detail-box := VerticalLayout { TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.bulk-detail; wrap: word-wrap; font-size: Family.body; color: Palette.foreground; } }
                }
                if root.bulk-root : Text { text: @tr("Main" => "Needs your administrator password once."); wrap: word-wrap; color: Family.muted; }
                if root.bulk-flatpak : Text { text: @tr("Main" => "Flatpak may ask for the password on its own."); wrap: word-wrap; color: Family.muted; }
                HorizontalLayout {
                    alignment: start;
                    Button { text: root.bulk-cmds-open ? @tr("Main" => "Hide commands") : @tr("Main" => "Show commands"); clicked => { root.bulk-cmds-open = !root.bulk-cmds-open; } }
                }
                if root.bulk-cmds-open : ScrollView {
                    height: Math.min(root.height * 0.16, cmds-box.preferred-height);
                    cmds-box := VerticalLayout { TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.bulk-cmds; wrap: word-wrap; font-size: Family.body; color: Palette.foreground; } }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Main" => "Cancel"); clicked => { root.bulk-confirming = false; root.bulk-cmds-open = false; } }
                    Button {
                        text: @tr("Main" => "Clean up");
                        primary: true;
                        enabled: root.bulk-count > 0;
                        clicked => {
                            root.bulk-cmds-open = false;
                            root.bulk-apply();
                        }
                    }
                }
            }
        }
    }

    // Confirm dialog for the boot menu: the exact change, as a diff, and the commands that make it.
    if root.boot-confirming : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, 560px);
            height: boot-dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            boot-dialog := VerticalLayout {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: root.boot-action == 0 ? @tr("Main" => "Change the GRUB timeout to {} s", root.boot-secs) : @tr("Main" => "Restore the GRUB settings backup");
                    font-size: Family.title;
                    font-weight: Family.section-weight;
                    wrap: word-wrap;
                    color: Palette.foreground;
                }
                Text { text: @tr("Main" => "Changes to /etc/default/grub:"); color: Palette.foreground; }
                TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.boot-diff; wrap: word-wrap; font-size: Family.body; color: Palette.foreground; }
                Text { text: @tr("Main" => "Commands that will run:"); color: Palette.foreground; }
                TextInput { read-only: true; selection-background-color: Palette.selection-background; selection-foreground-color: Palette.selection-foreground; text: root.boot-cmds; wrap: word-wrap; font-size: Family.body; color: Palette.foreground; }
                Text { text: @tr("Main" => "Needs your administrator password."); wrap: word-wrap; color: Family.muted; }
                Text {
                    text: root.boot-action == 0 ? @tr("Main" => "A backup is made first. If anything fails, it is put back. Undo: Restore the last backup.") : @tr("Main" => "This puts the file back as it was before the last change.");
                    wrap: word-wrap;
                    color: Family.muted;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Main" => "Cancel"); clicked => { root.boot-confirming = false; } }
                    Button {
                        text: root.boot-action == 0 ? @tr("Main" => "Change") : @tr("Main" => "Restore");
                        primary: true;
                        clicked => {
                            root.boot-confirming = false;
                            root.boot-apply(root.boot-action, root.boot-secs);
                        }
                    }
                }
            }
        }
    }

    // Preferences: appearance, language and About. An overlay like the confirm dialogs.
    if root.menu-open : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, Family.dialog-width);
            height: menu-dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            menu-dialog := VerticalLayout {
                padding: 16px;
                spacing: Family.gap-l;
                Text { text: @tr("Main" => "Preferences"); font-size: Family.page-title; font-weight: Family.page-weight; color: Palette.foreground; }
                PrefRow {
                    label: @tr("Main" => "Appearance");
                    ComboBox {
                        width: Family.control-width;
                        model: [@tr("Main" => "System default"), @tr("Main" => "Light"), @tr("Main" => "Dark")];
                        current-index <=> root.theme-index;
                        selected => { root.set-theme(root.theme-index); }
                    }
                }
                PrefRow {
                    label: @tr("Main" => "Language");
                    ComboBox {
                        width: Family.control-width;
                        model: [@tr("Main" => "System default"), "English", "Português (Brasil)"];
                        current-index <=> root.lang-index;
                        selected => { root.set-language(root.lang-index); }
                    }
                }
                PrefRow {
                    label: @tr("Main" => "Almost safe means older than (days)");
                    SpinBox {
                        width: Family.control-width;
                        minimum: 1;
                        maximum: 3650;
                        value <=> root.old-days;
                        edited(v) => { root.set-old-days(v); }
                    }
                }
                PrefRow {
                    label: @tr("Main" => "Allow emptying the Trash (cannot be undone)");
                    Switch {
                        checked <=> root.allow-empty-trash;
                        toggled => { root.set-allow-empty-trash(root.allow-empty-trash); }
                    }
                }
                HorizontalLayout {
                    spacing: Family.gap-m;
                    Button { text: @tr("Main" => "About"); clicked => { root.menu-open = false; root.about-open = true; root.prefs-closed(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Main" => "Close"); primary: true; clicked => { root.menu-open = false; root.prefs-closed(); } }
                }
            }
        }
    }

    if root.about-open : Rectangle {
        background: Family.scrim;
        TouchArea { }
        Rectangle {
            width: min(root.width - 32px, Family.dialog-width);
            height: about-dialog.preferred-height;
            background: Palette.background;
            border-radius: Family.radius;
            border-width: 1px;
            border-color: Palette.border;
            about-dialog := VerticalLayout {
                padding: 16px;
                AboutCard {
                    icon: @image-url("../../../packaging/io.github.evandro777.FastCheckup.svg");
                    name: "FastCheckup";
                    version: root.version;
                    description: @tr("Main" => "A light and fast Linux system inspector. It shows what is slow, large, unused or exposed, and you act on each item yourself.");
                    url: "github.com/evandro777/FastCheckup";
                    link-clicked(u) => { root.open-url(u); }
                    close => { root.about-open = false; }
                }
            }
        }
    }
}
